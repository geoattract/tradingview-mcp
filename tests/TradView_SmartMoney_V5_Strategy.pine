internalFilterConfluenceInput   = input.bool(   false,      'Strong Candle Filter (Ignore Weak Wick Breakouts)',  group = MINOR_GROUP,    tooltip = internalFilterConfluenceTooltip)
showInternalOrderBlocksInput    = input.bool(   true,       'Show Minor Launchpad Bands (Max Per Side)',          group = MINOR_GROUP,    tooltip = showInternalOrderBlocksTooltip, inline = 'iob')
