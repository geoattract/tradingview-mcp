// =========================================================================
internalLengthInput             = input.int(    8,          'Minor Lookback Bars (8 = Stronger, 5 = Faster)',     group = MINOR_GROUP,    tooltip = internalLengthTooltip, minval = 2, maxval = 25)
showInternalsInput              = input.bool(   true,       'Show Minor Steps (Dashed U-Turn / New High & Low)',  group = MINOR_GROUP,    tooltip = showInternalsTooltip)
