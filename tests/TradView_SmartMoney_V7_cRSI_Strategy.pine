//
// =========================================================================
// WHAT'S NEW IN V7 (SMARTMONEY V6 + cRSI UNIVERSAL V2 CONFLUENCE ENGINE):
// =========================================================================
// 1. EARLY 1-BAR HORIZONTAL "🎯 cRSI" SNAP-BACK BANDS (7 BARS EARLIER!):
//    - Standard SmartMoney bands must wait 8 candles (16 mins on a 2m chart)
//      to confirm a minor peak/floor or wait for a full structure breakout.
//    - V7 embeds the cRSI Universal V2 Dynamic Auto-Tuner under the hood.
//      The moment cRSI stretches into extreme territory (<= 30 Oversold or
//      >= 70 Overbought) and prints a Snap-Back Hook with above-average
//      volume, V7 immediately draws a horizontal Buyer/Seller Band on
//      Candle #1 ("🎯 cRSI Buy" / "🎯 cRSI Sell") so you can get ready to
//      Buy or Sell on the very first pullback (73.3% hold / 6.7% burst on
//      MGC1!, 71.4% hold / 14.3% burst on MNQ1!).
//    - If a standard structure breakout later confirms that same pivot, V7
//      seamlessly upgrades the existing band ("Buy Band • ... 🎯") instead
//      of drawing a duplicate box.
//
// 2. "🎯" cRSI RUBBER-BAND ORIGIN BADGE (80.0% HOLD / 6.7% BURST ON GOLD):
//    - Backtesting proved that Buyer/Seller Bands launched from a pivot
//      where cRSI stretched outside its dynamic Aqua band hold 80.0% of the
//      time on MGC1! with only a 6.7% burst rate. V7 automatically badges
//      these high-conviction bands with "🎯" on the right-edge tag.
//
// 3. cRSI TURN DOTS MODE DROPDOWN (🟢 / 🟡 ZERO-LAG ENTRY TRIGGER):
//    - Choose via dropdown how you want cRSI Snap-Back Dots displayed:
//      • "In-Band + Early 🎯 Bands (Recommended)": Plots 🟢/🟡 when a cRSI
//        hook fires inside/after touching an active band (3-bar touch memory)
//        OR when a new 1-Bar Early 🎯 cRSI Band forms.
//      • "All cRSI Snap-Back Dots (Match cRSI V2)": Plots every 🟢/🟡 dot
//        from cRSI Universal V2 directly on your price candles.
//      • "Strict In-Band Retests Only": Plots 🟢/🟡 only on pullbacks into
//        already-existing bands.
//      • "Off (Hide Dots)": Hides all cRSI dots.
//
// 4. ALL V6 UPGRADES INCLUDED + 0.30x ATR STOP-HUNT BUFFER DEFAULT:
//    - Includes V6's fixed Strong Candle Wick Filter, true 2-sided
//      Ping-Pong consolidation timing, 26-Bar Ichimoku Base Line ("💪")
//      reinforcement, ">=2.5x ATR ⚠️ Slam" falling-knife warnings, and sets
//      the default Stop-Hunt Buffer to the backtest-optimal 0.30x ATR.
// =========================================================================

strategy('TradView_SmartMoney_V7_cRSI_Strategy', 'MY_SmartMoney_V7_cRSI_Strategy', overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_order, commission_value = 1.0, process_orders_on_close = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
//CONSTANTS & STRINGS & INPUTS
//---------------------------------------------------------------------------------------------------------------------{
BULLISH_LEG                     = 1
BEARISH_LEG                     = 0

BULLISH                         = +1
BEARISH                         = -1

GREEN                           = #089981
RED                             = #F23645
BLUE                            = #2157f3
GRAY                            = #878b94
ORANGE                          = #ff9800
LIME_DOT                        = #00E676
GOLD_DOT                        = #FFD600
MONO_BULLISH                    = #b2b5be
MONO_BEARISH                    = #5d606b

HISTORICAL                      = 'Historical (All Past Signals)'
PRESENT                         = 'Present (Latest Signals Only)'

COLORED                         = 'Colored (Green / Red / Blue)'
MONOCHROME                      = 'Monochrome (Greyscale)'

ALL                             = 'All (Both U-Turn & New High/Low)'
BOS                             = 'New High/Low Only (Trend Steps)'
CHOCH                           = 'U-Turn Only (Reversals)'

TINY                            = size.tiny
SMALL                           = size.small
NORMAL                          = size.normal
LARGE                           = size.large
HUGE                            = size.huge

ATR                             = 'ATR (200-Bar Volatility)'
RANGE                           = 'Cumulative Mean Range (All Bars)'

CLOSE                           = 'Candle Close (Safer — Needs Full Close Beyond Band)'
HIGHLOW                         = 'Wick High/Low (Faster — Deletes When Wick Pierces Band)'

SOLID                           = '⎯⎯⎯ Solid'
DASHED                          = '---- Dashed'
DOTTED                          = '···· Dotted'

CUSTOM                          = 'Custom (Use My Switches in Groups 1–4)'
CLEAN                           = 'Clean (Beginner — Fewest Signals)'
SCALPER                         = 'Scalper (1m–5m Charts)'
SWINGP                          = 'Swing (15m+ Charts)'
FULL                            = 'Full (Show Everything)'

DOTS_BAND_AND_EARLY             = 'In-Band + Early 🎯 Bands (Recommended)'
DOTS_ALL                        = 'All cRSI Snap-Back Dots (Match cRSI V2)'
DOTS_IN_BAND_ONLY               = 'Strict In-Band Retests Only'
DOTS_OFF                        = 'Off (Hide Dots)'

MAX_BUFFER_SIZE                 = 5000

// --- 4 Clean, Logical Settings Groups ---
STRATEGY_GROUP                  = '0. 🎯 Strategy, Date Window & Risk Brackets'
GENERAL_GROUP                   = '1. ⚡ General & Quick Start'
MAJOR_GROUP                     = '2. 🏛️ MAJOR Settings (Big Trend — Solid Lines, Big Bands & Zones)'
MINOR_GROUP                     = '3. 🎯 MINOR & cRSI Settings (Short-Term, Early cRSI & Mini Bands)'
EXTRA_GROUP                     = '4. 🧰 Extra Tools (FVG Gaps, Yesterday High/Low & Candle Colors)'

presetTooltip                   = 'One-click setup:\n• Custom: Uses YOUR exact ON/OFF switches in Groups 1–4.\n• Clean: Major levels, Roof/Floor, Price Band Zones & Buyer/Seller Bands only.\n• Scalper: Faster settings (Major 20, Minor 5) + mini steps, sweeps, Early cRSI & Ping-Pong bands.\n• Swing: Standard settings (Major 50, Minor 8) + major bands and Double Tops/Bottoms.\n• Full: Everything ON.'
confirmTooltip                  = 'ON (recommended): Signals, sweeps, swing points, cRSI bands and alerts only appear AFTER the candle closes, so they never vanish mid-bar.\nOFF: Signals appear instantly while the candle is still moving, but may disappear if price pulls back before the close.'
modeTooltip                     = 'Historical: Keeps all past lines and labels on the chart.\nPresent: Shows only the most recent active lines for a super clean chart.'
styleTooltip                    = 'Colored: Standard Green/Red/Blue theme.\nMonochrome: Clean grey/silver theme.'
showBandLabelsTooltip           = 'Adds a tag on the right edge of each Buyer/Seller Band showing:\n• Type: 🎯 cRSI Buy/Sell (1-Bar Early Band) / Buy Band / Sell Band / 🏓 Range / MAJOR\n• Freshness: "Fresh ✨" vs "Tested 1x / 2x ⚠️"\n• Strength: "💪" when backed by Volume, Momentum & 26-Bar Base Equilibrium\n• cRSI Origin: "🎯" when launched from a cRSI rubber-band snap (80% hold / 6.7% burst on Gold)\n• Knife Warning: "⚠️ Slam" if hit by a violent >=2.5x ATR crash\nHover your mouse over the tag for full details and exact band prices.'
hideDistantBandsTooltip         = 'ON (recommended): Hides old Buyer/Seller Bands that are far away from current price so TradingView does not squash your candles flat. Those bands stay in memory and automatically reappear if price moves back near them.'
distantBandLookbackTooltip      = 'How many recent bars define the active screen range when hiding far-away bands (default 150 bars, plus a 4x ATR buffer).'

swingsLengthTooltip             = 'How many bars on each side are needed to confirm a MAJOR peak/floor (default 50). Controls all solid MAJOR lines, Major Bands, the Roof/Floor, and Premium/Discount Zones.'
showStructureTooltip            = 'Shows major trend breakouts (thick solid lines: "MAJOR U-Turn" and "MAJOR New High / Low").'
showMajorPrefixTooltip          = 'Adds the word "MAJOR" in front of solid Swing structure labels so they stand out from dashed minor steps.'
showSwingOrderBlocksTooltip     = 'Shows Major Buyer Bands (Cyan) and Major Seller Bands (Purple) created by major breakouts. The number box sets how many Major Buy Bands AND how many Major Sell Bands can show per side.'
showSweepsTooltip               = 'Detects when price pokes a wick past a Major High/Low to grab stop-losses and closes back inside ("Sweep ↑" / "Sweep ↓").'
showHighLowSwingsTooltip        = 'Draws the main Roof ("Target High" / "Protected High") and main Floor ("Protected Low" / "Target Low") on the right side of the chart.'
showSwingsTooltip               = 'Labels major swing peaks and valleys with HH (Higher High), HL (Higher Low), LH (Lower High), LL (Lower Low).'
showPremiumDiscountZonesTooltip = 'Draws 3 clean horizontal band zones across the current active range:\n• Top Red Band = Premium (Expensive — Sell / Take-Profit zone)\n• Middle Gray Band = Equilibrium (50% Half-Price magnet)\n• Bottom Green Band = Discount (Cheap — Buy / Take-Profit zone)'
useHtfFilterTooltip             = 'Reads the MAJOR trend on a bigger timeframe (finished candles only, no repaint) so you know the big-picture direction.'
autoHtfTooltip                  = 'ON (recommended): Automatically picks a smart higher timeframe based on your current chart:\n• 1m–3m chart -> 15m\n• 4m–10m chart -> 1H\n• 15m–30m chart -> 4H\n• 1H+ chart -> 1D'
htfLengthTooltip                = 'How many higher-timeframe bars on each side confirm a Big-Picture swing.\n• Default = 12 (3 hours on a 15m chart — adapts cleanly to Asian, London & NY sessions).'
fadeCounterTrendTooltip         = 'Makes structure labels that go AGAINST the higher-timeframe trend see-through, so with-trend signals stand out.'

internalLengthTooltip           = 'How many bars on each side are needed to confirm a MINOR peak/floor.\n• Default = 8 (Backtest-proven sweet spot on 2m MGC1! & MNQ1! — outperforms 5 and 10).\n• Use 5 only if you want ultra-fast scalping signals.'
showInternalsTooltip            = 'Shows short-term breakouts (dashed lines: "U-Turn" and "New High / New Low").'
internalFilterConfluenceTooltip = 'ON (recommended): Filters out weak mini breakouts where the candle has a large rejection wick against the breakout direction.'
filterExhaustedCrsiTooltip      = 'ON: Filters out minor "U-Turn" and "New High/Low" breakout labels when cRSI is already maxed out (>=75 on a bullish breakout or <=25 on a bearish breakout), preventing you from chasing rubber-band exhausted spikes (+11% win rate on MNQ1!).'
showInternalOrderBlocksTooltip  = 'Shows Minor Buyer Bands (Blue) and Minor Seller Bands (Yellow). The number box sets how many Buy Bands AND how many Sell Bands are kept on screen PER SIDE (e.g. 3 = up to 3 Buy Bands + 3 Sell Bands simultaneously).'
showCrsiBandsTooltip            = 'ON (recommended — 73.3% hold / 6.7% burst on MGC1!, 71.4% hold on MNQ1!):\nDraws a horizontal "🎯 cRSI Buy" or "🎯 cRSI Sell" band on Candle #1 as soon as cRSI stretches outside its dynamic Aqua Oversold/Overbought Band and hooks back inside.\n• Anchors to the true 5-bar swing trough/peak of the hook and appears 7 candles (14 mins on 2m) EARLIER than an 8-bar pivot!'
crsiDotModeTooltip              = 'Choose how cRSI Snap-Back Turn Dots (🟢 / 🟡) are plotted on your candles:\n• In-Band + Early 🎯 Bands (Recommended): Plots 🟢/🟡 when a cRSI hook fires inside/after touching an active band (3-bar touch memory) OR when a new Early 🎯 cRSI Band forms.\n• All cRSI Snap-Back Dots (Match cRSI V2): Plots every 🟢/🟡 dot from cRSI Universal V2 directly on your price chart.\n• Strict In-Band Retests Only: Plots 🟢/🟡 only on pullbacks into already-existing bands.\n• Off (Hide Dots): Hides all cRSI dots.'
showPingPongBandsTooltip        = 'ON (recommended): Solves the "one-sided band in consolidation" problem!\nWhen BOTH a confirmed minor ceiling and minor floor exist (or a Sweep / Double Top-Bottom forms) and price bounces by >= 1.2x ATR without breaking out, the script draws a "🏓 Range Buy" floor band or "🏓 Range Sell" ceiling band so you have BOTH sides to trade.'
filterWeakMiniBandsTooltip      = 'ON (recommended): Prevents weak "balloon" bands!\nA new Mini Band is only created when the move has real institutional backing (above-average Volume, strong ATR candle displacement, a Liquidity Sweep, or Major Trend alignment).'
hideWeakenedBandsTooltip        = 'Backtest-proven protection:\n• OFF (Default): Keeps all surviving Mini Bands visible, but adds a "⚠️ Slam" warning tag if price crashes violently into the band (>=2.5x ATR in 3 bars) or if price has already lost the 26-bar Base Line equilibrium.\n• ON: Automatically hides/removes Mini Bands that have lost Base Line support or suffered a violent slam so only high-probability bands remain on screen.'
orderBlockMitigationTooltip     = 'Decides when a Buyer/Seller Band is considered broken and deleted:\n• Candle Close (Recommended): Deleted only when a full candle body closes beyond the band + ATR buffer (wick stop-hunts do NOT pop the band!).\n• Wick High/Low: Deleted as soon as a wick pokes past the band + ATR buffer.'
obBufferTooltip                 = 'Extra breathing room (measured in ATR) added to the back edge of every Buyer/Seller Band so a stop-hunt poke does not prematurely delete the band.\n• Default = 0.30x ATR (Backtest-proven optimal setting on 2m MGC1! & MNQ1! — lifts Strong Band hold rate to 71.4% on Gold and 87.5% on MNQ).'
showBreakerBlocksTooltip        = 'When a Buyer Band fails (price closes below it), keep it on screen with a dashed orange border as a new Resistance ceiling (and vice versa).'
showInternalSweepsTooltip       = 'Detects short-term stop-hunt wicks ("Mini Sweep ↑" / "Mini Sweep ↓") that poke past a Minor High/Low and close back inside.'
maxSweepsTooltip                = 'Maximum number of recent Sweep lines/labels kept on screen so the chart stays clean.'
showEqualHighsLowsTooltip       = 'Spots when price bounces off the exact same ceiling twice ("Double Top") or same floor twice ("Double Bottom").'
equalHighsLowsLengthTooltip     = 'How many candles to wait after the 2nd bounce before confirming a Double Top/Bottom.'
equalHighsLowsThresholdTooltip  = 'How close the two peaks/floors must be (0.1 = strict match, 0.5 = looser match).'

showFairValueGapsTooltip        = 'Highlights 3-candle price imbalances (unfilled gaps) where price jumped too fast.'
shrinkFairValueGapsTooltip      = 'Automatically shrinks the FVG box as price fills part of the gap, showing only what is left.'
fairValueGapsThresholdTooltip   = 'Automatically hides tiny, meaningless gaps.'
fairValueGapsTimeframeTooltip   = 'Leave blank to use your current chart timeframe, or pick a higher timeframe.'
fairValueGapsExtendTooltip      = 'How many bars to stretch the FVG box to the right.'
showTrendTooltip                = 'Paints chart candles Green when short-term structure is Up, and Red when Down.'

// =========================================================================
// 0. 🎯 STRATEGY, DATE WINDOW & RISK BRACKETS
// =========================================================================
useDateFilterInput              = input.bool(   true,       'Enable Date Range Filter',                           group = STRATEGY_GROUP, tooltip = 'When ON, orders are only entered within the specified date window.')
startDateInput                  = input.time(   timestamp("2026-11-04 00:00:00"), 'Start Date & Time (2026-11-04 00:00)', group = STRATEGY_GROUP)
endDateInput                    = input.time(   timestamp("2026-11-07 23:59:59"), 'End Date & Time (2026-11-07 23:59)',   group = STRATEGY_GROUP)
closeAtEndInput                 = input.bool(   true,       'Close Open Positions at End of Window',             group = STRATEGY_GROUP, tooltip = 'Closes any open trade when the end date/time is reached.')
tradeDirectionInput             = input.string( 'Both',     'Trade Direction',                                    group = STRATEGY_GROUP, options = ['Both', 'Long Only', 'Short Only'])
v7SignalModeInput               = input.string( 'Strict In-Band Dots Only (inBandBullDot / inBandBearDot)', 'V7 Strategy Entry Trigger', group = STRATEGY_GROUP, options = ['Strict In-Band Dots Only (inBandBullDot / inBandBearDot)', 'In-Band Dots + Early 🎯 cRSI Bands'], tooltip = 'Strict rule: entries strictly occur ONLY when inBandBullDot (Long) or inBandBearDot (Short) fire.')
slModeInput                     = input.string( 'Structure Band / Swing Low-High', 'Stop Loss Calculation Mode',   group = STRATEGY_GROUP, options = ['Structure Band / Swing Low-High', 'ATR Multiple'])
slAtrMultInput                  = input.float(  1.5,        'Stop Loss ATR Multiple (Fallback or Direct)',        group = STRATEGY_GROUP, minval = 0.2, step = 0.1)
tpModeInput                     = input.string( 'Risk-to-Reward Ratio (x SL)', 'Take Profit Mode',               group = STRATEGY_GROUP, options = ['Risk-to-Reward Ratio (x SL)', 'ATR Multiple'])
rrRatioInput                    = input.float(  2.0,        'Take Profit Risk/Reward Ratio (e.g. 2.0 = 1:2)',     group = STRATEGY_GROUP, minval = 0.5, step = 0.1)
tpAtrMultInput                  = input.float(  3.0,        'Take Profit ATR Multiple',                           group = STRATEGY_GROUP, minval = 0.5, step = 0.5)
showBracketPlotsInput           = input.bool(   true,       'Show SL/TP Bracket Lines on Chart',                  group = STRATEGY_GROUP)

// =========================================================================
// 1. ⚡ GENERAL & QUICK START
// =========================================================================
presetInput                     = input.string( CUSTOM,     'Preset (One-Click Setup)',                           group = GENERAL_GROUP,  tooltip = presetTooltip, options = [CUSTOM, CLEAN, SCALPER, SWINGP, FULL])
confirmOnCloseInput             = input.bool(   true,       'Confirm on Candle Close (No Repaint — Recommended)', group = GENERAL_GROUP,  tooltip = confirmTooltip)
modeInput                       = input.string( PRESENT,    'Display Mode (All History vs Latest Only)',          group = GENERAL_GROUP,  tooltip = modeTooltip, options = [HISTORICAL, PRESENT])
styleInput                      = input.string( COLORED,    'Color Theme (Colored vs Monochrome)',                group = GENERAL_GROUP,  tooltip = styleTooltip, options = [COLORED, MONOCHROME])
showBandLabelsInput             = input.bool(   true,       'Show Band Freshness & Strength Tags (Right Edge)',   group = GENERAL_GROUP,  tooltip = showBandLabelsTooltip, inline = 'blbl')
bandLabelSizeInput              = input.string( NORMAL,     '',                                                   group = GENERAL_GROUP,  options = [TINY, SMALL, NORMAL, LARGE], inline = 'blbl')
hideDistantBandsInput           = input.bool(   true,       'Auto-Fit Chart Scale (Hide Far-Away Bands)',         group = GENERAL_GROUP,  tooltip = hideDistantBandsTooltip, inline = 'fit')
distantBandBarsInput            = input.int(    150,        '',                                                   group = GENERAL_GROUP,  tooltip = distantBandLookbackTooltip, minval = 30, maxval = 1000, inline = 'fit')

// =========================================================================
// 2. 🏛️ MAJOR SETTINGS (Big Trend — Solid Lines, Big Bands & Zones)
// =========================================================================
swingsLengthInput               = input.int(    50,         'Major Lookback Bars (Controls All Solid Lines)',     group = MAJOR_GROUP,    tooltip = swingsLengthTooltip, minval = 10)
showStructureInput              = input.bool(   true,       'Show Major Structure Lines (Solid MAJOR Lines)',     group = MAJOR_GROUP,    tooltip = showStructureTooltip)
showMajorPrefixInput            = input.bool(   true,       'Add "MAJOR" Word on Solid Lines',                    group = MAJOR_GROUP,    tooltip = showMajorPrefixTooltip)
showSwingBullInput              = input.string( ALL,        'Bullish Major Signals (Up ↑)',                       group = MAJOR_GROUP,    inline = 'mbull', options = [ALL, BOS, CHOCH])
swingBullColorInput             = input.color(  GREEN,      '',                                                   group = MAJOR_GROUP,    inline = 'mbull')
showSwingBearInput              = input.string( ALL,        'Bearish Major Signals (Down ↓)',                     group = MAJOR_GROUP,    inline = 'mbear', options = [ALL, BOS, CHOCH])
swingBearColorInput             = input.color(  RED,        '',                                                   group = MAJOR_GROUP,    inline = 'mbear')
swingStructureSize              = input.string( LARGE,      'Major Label Text Size',                              group = MAJOR_GROUP,    options = [TINY, SMALL, NORMAL, LARGE, HUGE])
showSwingOrderBlocksInput       = input.bool(   true,       'Show MAJOR Launchpad Bands (Max Per Side)',          group = MAJOR_GROUP,    tooltip = showSwingOrderBlocksTooltip, inline = 'mob')
swingOrderBlocksSizeInput       = input.int(    3,          '',                                                   group = MAJOR_GROUP,    minval = 1, maxval = 10, inline = 'mob')
swingBullishOrderBlockColor     = input.color(color.new(#26c6da, 25), 'Major Buyer Band Color (Cyan / Teal — 75%)', group = MAJOR_GROUP)
swingBearishOrderBlockColor     = input.color(color.new(#9c27b0, 25), 'Major Seller Band Color (Purple — 75%)',     group = MAJOR_GROUP)
showSweepsInput                 = input.bool(   true,       'Show Major Stop-Hunt Traps (Sweep ↑ / Sweep ↓)',     group = MAJOR_GROUP,    tooltip = showSweepsTooltip)
showHighLowSwingsInput          = input.bool(   true,       'Show Main Roof & Floor (Protected / Target High/Low)', group = MAJOR_GROUP,  tooltip = showHighLowSwingsTooltip, inline = 'hlswings')
highLowSwingsSizeInput          = input.string( LARGE,      '',                                                   group = MAJOR_GROUP,    options = [TINY, SMALL, NORMAL, LARGE, HUGE], inline = 'hlswings')
showSwingsInput                 = input.bool(   false,      'Show Peak/Floor Letters (HH, HL, LH, LL)',           group = MAJOR_GROUP,    tooltip = showSwingsTooltip)
showPremiumDiscountZonesInput   = input.bool(   true,       'Show Price Band Zones (Premium / 50% / Discount)',   group = MAJOR_GROUP,    tooltip = showPremiumDiscountZonesTooltip)
premiumZoneColorInput           = input.color(  RED,        'Premium Band (Top = Expensive / Sell Zone)',         group = MAJOR_GROUP)
equilibriumZoneColorInput       = input.color(  GRAY,       'Equilibrium Band (Middle 50% = Fair Price)',         group = MAJOR_GROUP)
discountZoneColorInput          = input.color(  GREEN,      'Discount Band (Bottom = Cheap / Buy Zone)',          group = MAJOR_GROUP)
zoneLabelSizeInput              = input.string( NORMAL,     'Zone Label Text Size',                               group = MAJOR_GROUP,    options = [TINY, SMALL, NORMAL, LARGE, HUGE])
useHtfFilterInput               = input.bool(   true,       'Use Big-Picture Filter (Higher Timeframe Trend)',    group = MAJOR_GROUP,    tooltip = useHtfFilterTooltip)
autoHtfInput                    = input.bool(   true,       'Auto-Pick Higher Timeframe (Adapts to Chart TF)',    group = MAJOR_GROUP,    tooltip = autoHtfTooltip)
htfTimeframeInput               = input.timeframe('15',     'Manual Higher Timeframe (When Auto Is Off)',         group = MAJOR_GROUP)
htfLengthInput                  = input.int(    12,         'Big-Picture Major Lookback Bars (12 = Session Sync)',group = MAJOR_GROUP,    tooltip = htfLengthTooltip, minval = 5)
fadeCounterTrendInput           = input.bool(   false,      'Fade Labels That Go Against the Big Trend',          group = MAJOR_GROUP,    tooltip = fadeCounterTrendTooltip)

// =========================================================================
// 3. 🎯 MINOR & cRSI SETTINGS (Short-Term, Early cRSI & Mini Bands)
// =========================================================================
internalLengthInput             = input.int(    8,          'Minor Lookback Bars (8 = Sweet Spot, 5 = Faster)',   group = MINOR_GROUP,    tooltip = internalLengthTooltip, minval = 2, maxval = 25)
showInternalsInput              = input.bool(   true,       'Show Minor Steps (Dashed U-Turn / New High & Low)',  group = MINOR_GROUP,    tooltip = showInternalsTooltip)
showInternalBullInput           = input.string( ALL,        'Bullish Minor Signals (Up ↑)',                       group = MINOR_GROUP,    inline = 'ibull', options = [ALL, BOS, CHOCH])
internalBullColorInput          = input.color(  GREEN,      '',                                                   group = MINOR_GROUP,    inline = 'ibull')
showInternalBearInput           = input.string( ALL,        'Bearish Minor Signals (Down ↓)',                     group = MINOR_GROUP,    inline = 'ibear', options = [ALL, BOS, CHOCH])
internalBearColorInput          = input.color(  RED,        '',                                                   group = MINOR_GROUP,    inline = 'ibear')
internalStructureSize           = input.string( NORMAL,     'Minor Label Text Size',                              group = MINOR_GROUP,    options = [TINY, SMALL, NORMAL, LARGE, HUGE])
internalFilterConfluenceInput   = input.bool(   true,       'Strong Candle Filter (Ignore Weak Wick Breakouts)',  group = MINOR_GROUP,    tooltip = internalFilterConfluenceTooltip)
filterExhaustedCrsiInput        = input.bool(   false,      'cRSI Anti-Chase Filter (Skip Maxed-Out Breakouts)',  group = MINOR_GROUP,    tooltip = filterExhaustedCrsiTooltip)
showInternalOrderBlocksInput    = input.bool(   true,       'Show Minor Launchpad Bands (Max Per Side)',          group = MINOR_GROUP,    tooltip = showInternalOrderBlocksTooltip, inline = 'iob')
internalOrderBlocksSizeInput    = input.int(    3,          '',                                                   group = MINOR_GROUP,    minval = 1, maxval = 10, inline = 'iob')
internalBullishOrderBlockColor  = input.color(color.new(#2962ff, 50), 'Mini Buyer Band Color (Blue Launchpad — 50%)',   group = MINOR_GROUP)
internalBearishOrderBlockColor  = input.color(color.new(#ffeb3b, 50), 'Mini Seller Band Color (Yellow Slam-Pad — 50%)', group = MINOR_GROUP)
showCrsiBandsInput              = input.bool(   true,       'Show Early cRSI Rubber-Band Zones (🎯 1-Bar Early)', group = MINOR_GROUP,    tooltip = showCrsiBandsTooltip)
crsiDotModeInput                = input.string( DOTS_BAND_AND_EARLY, 'cRSI Turn Dots Mode (🟢 / 🟡)',             group = MINOR_GROUP,    tooltip = crsiDotModeTooltip, options = [DOTS_BAND_AND_EARLY, DOTS_ALL, DOTS_IN_BAND_ONLY, DOTS_OFF])
showPingPongBandsInput          = input.bool(   true,       'Show Ping-Pong Consolidation Bands (🏓 Both Sides)', group = MINOR_GROUP,    tooltip = showPingPongBandsTooltip)
filterWeakMiniBandsInput        = input.bool(   true,       'Strengthen Mini Bands (Filter Out Weak "Balloons")', group = MINOR_GROUP,    tooltip = filterWeakMiniBandsTooltip)
hideWeakenedBandsInput          = input.bool(   false,      'Auto-Hide Weakened / Falling-Knife Mini Bands',      group = MINOR_GROUP,    tooltip = hideWeakenedBandsTooltip)
orderBlockMitigationInput       = input.string( CLOSE,      'Delete Band When Broken By (Close vs Wick)',         group = MINOR_GROUP,    tooltip = orderBlockMitigationTooltip, options = [CLOSE, HIGHLOW])
obBufferInput                   = input.float(  0.30,       'Band Stop-Hunt Buffer (x ATR Extra Room)',           group = MINOR_GROUP,    tooltip = obBufferTooltip, minval = 0.0, maxval = 1.0, step = 0.05)
orderBlockFilterInput           = input.string( ATR,        'Spike Candle Filter (ATR vs Avg Range)',             group = MINOR_GROUP,    options = [ATR, RANGE])
showBreakerBlocksInput          = input.bool(   false,      'Flip Broken Bands into Support/Resistance (Breaker)',group = MINOR_GROUP,    tooltip = showBreakerBlocksTooltip)
showInternalSweepsInput         = input.bool(   true,       'Show Minor Stop-Hunt Traps (Mini Sweep ↑ / ↓)',      group = MINOR_GROUP,    tooltip = showInternalSweepsTooltip)
maxSweepsInput                  = input.int(    15,         'Max Sweeps Kept On Chart (Older Ones Deleted)',      group = MINOR_GROUP,    tooltip = maxSweepsTooltip, minval = 1, maxval = 50)
sweepLabelSizeInput             = input.string( NORMAL,     'Sweep Label Text Size',                              group = MINOR_GROUP,    options = [TINY, SMALL, NORMAL, LARGE, HUGE])
showEqualHighsLowsInput         = input.bool(   false,      'Show Double Top & Double Bottom (Twin Levels)',      group = MINOR_GROUP,    tooltip = showEqualHighsLowsTooltip)
equalHighsLowsLengthInput       = input.int(    3,          'Bounce Confirmation Delay (Bars to Wait)',           group = MINOR_GROUP,    tooltip = equalHighsLowsLengthTooltip, minval = 1)
equalHighsLowsThresholdInput    = input.float(  0.1,        'Price Match Sensitivity (0.1 = Strict, 0.5 = Loose)',group = MINOR_GROUP,    tooltip = equalHighsLowsThresholdTooltip, minval = 0, maxval = 0.5, step = 0.1)
equalHighsLowsSizeInput         = input.string( NORMAL,     'Double Top/Bottom Text Size',                        group = MINOR_GROUP,    options = [TINY, SMALL, NORMAL, LARGE, HUGE])

// =========================================================================
// 4. 🧰 EXTRA TOOLS (FVG Gaps, Yesterday High/Low & Candle Colors)
// =========================================================================
showFairValueGapsInput          = input.bool(   false,      'Show Fair Value Gaps (Unfilled 3-Bar Gaps)',         group = EXTRA_GROUP,    tooltip = showFairValueGapsTooltip)
shrinkFairValueGapsInput        = input.bool(   true,       'Shrink Gap Box as Price Partially Fills It',         group = EXTRA_GROUP,    tooltip = shrinkFairValueGapsTooltip)
fairValueGapsThresholdInput     = input.bool(   true,       'Auto-Filter Out Tiny Gaps',                          group = EXTRA_GROUP,    tooltip = fairValueGapsThresholdTooltip)
fairValueGapsTimeframeInput     = input.timeframe('',       'Gap Timeframe (Blank = Current Chart)',              group = EXTRA_GROUP,    tooltip = fairValueGapsTimeframeTooltip)
fairValueGapsBullColorInput     = input.color(color.new(#00ff68, 70), 'Bullish Gap Color (Green)',                group = EXTRA_GROUP)
fairValueGapsBearColorInput     = input.color(color.new(#ff0008, 70), 'Bearish Gap Color (Red)',                  group = EXTRA_GROUP)
fairValueGapsExtendInput        = input.int(    5,          'Extend Gap Box Right (Number of Bars)',              group = EXTRA_GROUP,    tooltip = fairValueGapsExtendTooltip, minval = 0)
showDailyLevelsInput            = input.bool(   false,      'Previous Day High & Low (PDH / PDL)',                group = EXTRA_GROUP,    inline = 'daily')
dailyLevelsStyleInput           = input.string( SOLID,      '',                                                   group = EXTRA_GROUP,    inline = 'daily', options = [SOLID, DASHED, DOTTED])
dailyLevelsColorInput           = input.color(  BLUE,       '',                                                   group = EXTRA_GROUP,    inline = 'daily')
showWeeklyLevelsInput           = input.bool(   false,      'Previous Week High & Low (PWH / PWL)',               group = EXTRA_GROUP,    inline = 'weekly')
weeklyLevelsStyleInput          = input.string( SOLID,      '',                                                   group = EXTRA_GROUP,    inline = 'weekly', options = [SOLID, DASHED, DOTTED])
weeklyLevelsColorInput          = input.color(  BLUE,       '',                                                   group = EXTRA_GROUP,    inline = 'weekly')
showMonthlyLevelsInput          = input.bool(   false,      'Previous Month High & Low (PMH / PML)',              group = EXTRA_GROUP,    inline = 'monthly')
monthlyLevelsStyleInput         = input.string( SOLID,      '',                                                   group = EXTRA_GROUP,    inline = 'monthly', options = [SOLID, DASHED, DOTTED])
monthlyLevelsColorInput         = input.color(  BLUE,       '',                                                   group = EXTRA_GROUP,    inline = 'monthly')
showTrendInput                  = input.bool(   false,      'Color Chart Candles by Trend (Green/Red)',           group = EXTRA_GROUP,    tooltip = showTrendTooltip)

//---------------------------------------------------------------------------------------------------------------------}
//PRESET RESOLUTION (Effective settings actually used by the script)
//---------------------------------------------------------------------------------------------------------------------{
bool isCustom               = presetInput == CUSTOM
string modeEff              = isCustom ? modeInput : (presetInput == CLEAN or presetInput == SCALPER) ? PRESENT : HISTORICAL
bool showInternalsEff       = isCustom ? showInternalsInput : presetInput != CLEAN
bool showStructureEff       = isCustom ? showStructureInput : true
bool showSwingsEff          = isCustom ? showSwingsInput : presetInput == FULL
bool showHighLowSwingsEff   = isCustom ? showHighLowSwingsInput : true
int  swingsLengthEff        = isCustom ? swingsLengthInput : presetInput == SCALPER ? 20 : 50
int  internalLengthEff      = isCustom ? internalLengthInput : presetInput == SCALPER ? 5 : 8
bool showSweepsEff          = isCustom ? showSweepsInput : true
bool showInternalSweepsEff  = isCustom ? showInternalSweepsInput : (presetInput == SCALPER or presetInput == FULL)
bool showInternalOBEff      = isCustom ? showInternalOrderBlocksInput : true
bool showSwingOBEff         = isCustom ? showSwingOrderBlocksInput : (presetInput == SWINGP or presetInput == FULL)
bool showEqualEff           = isCustom ? showEqualHighsLowsInput : presetInput != CLEAN
bool showFVGEff             = isCustom ? showFairValueGapsInput : (presetInput == SCALPER or presetInput == FULL)
bool showZonesEff           = isCustom ? showPremiumDiscountZonesInput : true

// No-repaint gate: TRUE on every historical bar, and only on the closing tick of a realtime bar
bool confirmed              = not confirmOnCloseInput or barstate.isconfirmed

//---------------------------------------------------------------------------------------------------------------------}
//PLAIN-ENGLISH HOVER BUBBLE EXPLANATIONS (TOOLTIPS FOR ALL CHART LABELS)
//---------------------------------------------------------------------------------------------------------------------{
getLabelTooltip(string tag) =>
    switch tag
        'Double Top'                    => '🏔️ DOUBLE TOP (Twin Ceiling)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: Price hit the exact same ceiling twice and bounced down.\n• Why it matters: Lots of traders hide their Stop-Loss orders just above this twin ceiling.\n• How to trade: Watch out for a "Sweep ↓" stop-hunt poke above this level, or use it as a Take-Profit magnet when Long.'
        'Double Bottom'                 => '🛟 DOUBLE BOTTOM (Twin Floor)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: Price bounced off the exact same floor twice and held up.\n• Why it matters: Lots of traders hide their Stop-Loss orders just below this twin floor.\n• How to trade: Watch for a "Sweep ↑" stop-hunt dip below this floor to spring price higher, or use it as a Take-Profit target when Short.'
        'U-Turn ↑'                      => '🔄 MINOR U-TURN ↑ (Short-Term Bullish Reversal / CHoCH)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: Short-term momentum just flipped from DOWN to UP by closing above the last minor peak.\n• How to trade: Early heads-up that buyers are stepping in (highest win rate when your Ichimoku Strip is 🟡 Amber or 🟢 Green and cRSI is not maxed out). Wait for a dip into the Buy Band / 26-Bar Base Line!'
        'U-Turn ↓'                      => '🔄 MINOR U-TURN ↓ (Short-Term Bearish Reversal / CHoCH)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: Short-term momentum just flipped from UP to DOWN by closing below the last minor floor.\n• How to trade: Early heads-up that sellers are stepping in (highest win rate when your Ichimoku Strip is 🟡 Amber or 🔴 Red and cRSI is not maxed out). Wait for a bounce into the Sell Band / 26-Bar Base Line!'
        'MAJOR U-Turn ↑'                => '🚨 MAJOR U-TURN ↑ (Big Trend Reversal UP / Swing CHoCH)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: The MAIN trend just flipped from DOWN to UP by breaking a major ceiling!\n• How to trade: Stop looking for shorts. Wait for price to pull back toward the 50% Equilibrium or green Discount band (or a Buyer Band) to look for LONGS.'
        'MAJOR U-Turn ↓'                => '🚨 MAJOR U-TURN ↓ (Big Trend Reversal DOWN / Swing CHoCH)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: The MAIN trend just flipped from UP to DOWN by breaking a major floor!\n• How to trade: Stop looking for longs. Wait for price to bounce toward the 50% Equilibrium or red Premium band (or a Seller Band) to look for SHORTS.'
        'New High ↑'                    => '📈 MINOR NEW HIGH ↑ (Short-Term Uptrend Step / BOS)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: Price is already in a short-term uptrend and just climbed another step higher.\n• How to trade: Confirms buyers are in control. Do not chase the high—wait for a normal pullback into a Buyer Band.'
        'New Low ↓'                     => '📉 MINOR NEW LOW ↓ (Short-Term Downtrend Step / BOS)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: Price is already in a short-term downtrend and just dropped another step lower.\n• How to trade: Confirms sellers are in control. Do not chase the low—wait for a normal bounce into a Seller Band.'
        'MAJOR New High ↑'              => '🚀 MAJOR NEW HIGH ↑ (Big Uptrend Continuation / Swing BOS)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: The main uptrend just broke through the big Roof and made a brand-new major high!\n• How to trade: Big buyers are strongly in charge. Wait for a pullback toward the 50% Equilibrium or Discount band before buying.'
        'MAJOR New Low ↓'               => '💥 MAJOR NEW LOW ↓ (Big Downtrend Continuation / Swing BOS)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: The main downtrend just smashed through the big Floor and made a brand-new major low!\n• How to trade: Big sellers are strongly in charge. Wait for a bounce toward the 50% Equilibrium or Premium band before shorting.'
        'Sweep ↑'                       => '🪤 MAJOR SWEEP ↑ (Bullish Stop-Hunt Trap)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: Price poked a wick BELOW a major floor to grab stop-losses, then snapped right back above it before the candle closed!\n• How to trade: High-probability bullish reversal signal—especially near the green Discount band or inside a Buyer Band.'
        'Sweep ↓'                       => '🪤 MAJOR SWEEP ↓ (Bearish Stop-Hunt Trap)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: Price poked a wick ABOVE a major ceiling to grab stop-losses, then snapped right back below it before the candle closed!\n• How to trade: High-probability bearish reversal signal—especially near the red Premium band or inside a Seller Band.'
        'Mini Sweep ↑'                  => '🪤 MINI SWEEP ↑ (Short-Term Bullish Stop-Hunt)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: A quick wick dipped below a recent minor floor and closed back above.\n• How to trade: Great early entry trigger for a LONG when price is sitting inside a Buyer Band, at the bottom of a Ping-Pong range, or on an 🟡 Amber pullback strip.'
        'Mini Sweep ↓'                  => '🪤 MINI SWEEP ↓ (Short-Term Bearish Stop-Hunt)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: A quick wick poked above a recent minor ceiling and closed back below.\n• How to trade: Great early entry trigger for a SHORT when price is sitting inside a Seller Band, at the top of a Ping-Pong range, or on an 🟡 Amber pullback strip.'
        'Target High'                   => '🎯 TARGET HIGH (The Roof / Magnet Above)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: Because the Major Trend is UP, this highest peak is a "Weak High" waiting to be broken.\n• How to trade: Use this line as your Take-Profit target when Long. Do NOT short here—uptrends love to smash through Target Highs!'
        'Protected Low'                 => '🛡️ PROTECTED LOW (The Floor / Big Boss Support)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: This is the "Strong Low" that launched the current uptrend leg.\n• How to trade: As long as price stays above this floor, the Major Uptrend is alive. Place your safest Stop-Loss just below this line.'
        'Protected High'                => '🛡️ PROTECTED HIGH (The Roof / Big Boss Ceiling)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: This is the "Strong High" that started the current downtrend leg.\n• How to trade: As long as price stays below this roof, the Major Downtrend is alive. Place your safest Stop-Loss just above this line.'
        'Target Low'                    => '🎯 TARGET LOW (The Floor / Magnet Below)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: Because the Major Trend is DOWN, this lowest floor is a "Weak Low" waiting to be broken.\n• How to trade: Use this line as your Take-Profit target when Short. Do NOT buy here—downtrends love to smash through Target Lows!'
        'Premium (Expensive)'           => '🔴 PREMIUM BAND (Top of Range = Expensive Price)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: Price is at the top of the current trading range (expensive like retail price).\n• How to trade: Avoid buying up here! Look to take profit on Longs, or watch for Short signals if the trend is Down.'
        'Equilibrium (50%)'             => '⚖️ EQUILIBRIUM BAND (50% Fair Value / Half-Price Magnet)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: The exact middle (halfway point) between the Roof and the Floor.\n• How to trade: Price loves to get pulled back to this 50% band after a big move. Below this band = Cheap (Discount); Above = Expensive (Premium).'
        'Discount (Cheap)'              => '🟢 DISCOUNT BAND (Bottom of Range = Cheap / Wholesale Price)\n━━━━━━━━━━━━━━━━━━━━\n• What it means: Price is at the bottom of the current trading range (on sale!).\n• How to trade: Avoid shorting down here! Look to take profit on Shorts, or watch for Buy signals if the trend is Up.'
        'HH'                            => '🏔️ HH = HIGHER HIGH\n━━━━━━━━━━━━━━━━━━━━\n• This major peak is HIGHER than the previous major peak—a sign of an uptrend.'
        'HL'                            => '🛟 HL = HIGHER LOW\n━━━━━━━━━━━━━━━━━━━━\n• This major floor is HIGHER than the previous major floor—buyers stepped in earlier than last time.'
        'LH'                            => '🏔️ LH = LOWER HIGH\n━━━━━━━━━━━━━━━━━━━━\n• This major peak is LOWER than the previous major peak—sellers stepped in earlier than last time.'
        'LL'                            => '🕳️ LL = LOWER LOW\n━━━━━━━━━━━━━━━━━━━━\n• This major floor is LOWER than the previous major floor—a sign of a downtrend.'
        => ''

//---------------------------------------------------------------------------------------------------------------------}
//DATA STRUCTURES & VARIABLES
//---------------------------------------------------------------------------------------------------------------------{
type alerts
    bool internalBullishBOS         = false
    bool internalBearishBOS         = false
    bool internalBullishCHoCH       = false
    bool internalBearishCHoCH       = false
    bool swingBullishBOS            = false
    bool swingBearishBOS            = false
    bool swingBullishCHoCH          = false
    bool swingBearishCHoCH          = false
    bool bullishSweep               = false
    bool bearishSweep               = false
    bool miniBullishSweep           = false
    bool miniBearishSweep           = false
    bool internalBullishOrderBlock  = false
    bool internalBearishOrderBlock  = false
    bool swingBullishOrderBlock     = false
    bool swingBearishOrderBlock     = false
    bool pingPongBuyBand            = false
    bool pingPongSellBand           = false
    bool crsiBuyBand                = false
    bool crsiSellBand               = false
    bool inBandBullDot              = false
    bool inBandBearDot              = false
    bool equalHighs                 = false
    bool equalLows                  = false
    bool bullishFairValueGap        = false
    bool bearishFairValueGap        = false

type trailingExtremes
    float top
    float bottom
    int barTime
    int barIndex
    int lastTopTime
    int lastBottomTime

// Normalized FVG: `top` is ALWAYS the upper price boundary, `bottom` is ALWAYS the lower price boundary
type fairValueGap
    float top
    float bottom
    int bias
    box topBox
    box bottomBox

type trend
    int bias    

type equalDisplay
    line l_ine      = na
    label l_abel    = na

type pivot
    float currentLevel
    float lastLevel
    bool crossed
    bool swept          = false
    bool pingPongStored = false
    int barTime         = time
    int barIndex        = bar_index

type orderBlock
    float barHigh
    float barLow
    int barTime    
    int bias
    bool isBreaker      = false
    int touches         = 0
    bool insideBand     = true
    bool isPingPong     = false
    bool isCrsiBand     = false
    bool hasCrsiOrigin  = false
    bool isStrong       = false
    bool isSlammed      = false

var pivot swingHigh                         = pivot.new(na, na, false, false, false)
var pivot swingLow                          = pivot.new(na, na, false, false, false)
var pivot internalHigh                      = pivot.new(na, na, false, false, false)
var pivot internalLow                       = pivot.new(na, na, false, false, false)
var pivot equalHigh                         = pivot.new(na, na, false, false, false)
var pivot equalLow                          = pivot.new(na, na, false, false, false)

var trend swingTrend                        = trend.new(0)
var trend internalTrend                     = trend.new(0)

var equalDisplay equalHighDisplay           = equalDisplay.new()
var equalDisplay equalLowDisplay            = equalDisplay.new()

var array<fairValueGap> fairValueGaps       = array.new<fairValueGap>()
var array<float> parsedHighs                = array.new<float>()
var array<float> parsedLows                 = array.new<float>()
var array<float> highs                      = array.new<float>()
var array<float> lows                       = array.new<float>()
var array<int> times                        = array.new<int>()
var array<float> crsiBuffer                 = array.new<float>()
var array<float> crsiDbBuffer               = array.new<float>()
var array<float> crsiUbBuffer               = array.new<float>()

var trailingExtremes trailing               = trailingExtremes.new()
var array<orderBlock> swingOrderBlocks      = array.new<orderBlock>()
var array<orderBlock> internalOrderBlocks   = array.new<orderBlock>()
var array<box> swingOrderBlocksBoxes        = array.new<box>()
var array<box> internalOrderBlocksBoxes     = array.new<box>()
var array<label> swingOrderBlocksLabels     = array.new<label>()
var array<label> internalOrderBlocksLabels  = array.new<label>()

// Rolling storage for sweeps so old drawings are cleaned up automatically
var array<line>  sweepLines                 = array.new<line>()
var array<label> sweepLabels                = array.new<label>()

var swingBullishColor                       = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
var swingBearishColor                       = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
var fairValueGapBullishColor                = styleInput == MONOCHROME ? color.new(MONO_BULLISH, 70) : fairValueGapsBullColorInput
var fairValueGapBearishColor                = styleInput == MONOCHROME ? color.new(MONO_BEARISH, 70) : fairValueGapsBearColorInput
var premiumZoneColor                        = styleInput == MONOCHROME ? MONO_BEARISH : premiumZoneColorInput
var discountZoneColor                       = styleInput == MONOCHROME ? MONO_BULLISH : discountZoneColorInput 

varip int currentBarIndex                   = bar_index
varip int lastBarIndex                      = bar_index
alerts currentAlerts                        = alerts.new()
var initialTime                             = time

// SEPARATE BUY & SELL QUOTA: Pre-allocate `2 * SizeInput` boxes so up to N Buy Bands AND N Sell Bands can show simultaneously!
if barstate.isfirst
    if showSwingOBEff
        for index = 1 to swingOrderBlocksSizeInput * 2
            swingOrderBlocksBoxes.push(box.new(na, na, na, na, xloc = xloc.bar_time))
    if showInternalOBEff
        for index = 1 to internalOrderBlocksSizeInput * 2
            internalOrderBlocksBoxes.push(box.new(na, na, na, na, xloc = xloc.bar_time))

bearishOrderBlockMitigationSource           = orderBlockMitigationInput == CLOSE ? close : high
bullishOrderBlockMitigationSource           = orderBlockMitigationInput == CLOSE ? close : low
atrMeasure                                  = ta.atr(200)
atr14                                       = nz(ta.atr(14), high - low)
atr100                                      = nz(ta.atr(100), atr14)
avgVol20                                    = ta.sma(volume, 20)
// 26-Bar Base Line Equilibrium (Kijun-sen midpoint) used silently under the hood to evaluate Band reinforcement & Knife risk
baseLine26                                  = math.avg(ta.highest(26), ta.lowest(26))

//---------------------------------------------------------------------------------------------------------------------}
//BUILT-IN cRSI UNIVERSAL V2 ENGINE (100% Matching TradView_cRSI_Univ_V2_161026.md)
//---------------------------------------------------------------------------------------------------------------------{
f_dyn_rma(float src_val, int length) =>
    float alpha = length > 0 ? 1.0 / length : 1.0
    var float sum = na
    sum := na(sum[1]) ? src_val : alpha * src_val + (1.0 - alpha) * nz(sum[1])
    sum

float crsiAtrRatio                          = atr100 > 0 ? atr14 / atr100 : 1.0
int   crsiDomCycle                          = int(math.max(10, math.min(50, math.round(20.0 / crsiAtrRatio))))
int   crsiCycleLen                          = int(math.max(1, crsiDomCycle / 2))
int   crsiCyclicMemory                      = int(crsiDomCycle * 2)
float crsiUp                                = f_dyn_rma(math.max(ta.change(close), 0), crsiCycleLen)
float crsiDown                              = f_dyn_rma(-math.min(ta.change(close), 0), crsiCycleLen)
float crsiRsiVal                            = crsiDown == 0 ? 100.0 : crsiUp == 0 ? 0.0 : 100.0 - 100.0 / (1.0 + crsiUp / crsiDown)
float crsiTorque                            = 2.0 / 11.0
int   crsiPhasingLag                        = 5
var float crsi                              = na
crsi                                        := crsiTorque * (2.0 * crsiRsiVal - nz(crsiRsiVal[crsiPhasingLag])) + (1.0 - crsiTorque) * nz(crsi[1])
float crsiDb                                = ta.percentile_nearest_rank(crsi, crsiCyclicMemory, 10.0)
float crsiUb                                = ta.percentile_nearest_rank(crsi, crsiCyclicMemory, 90.0)
bool  snapDownFromTop                       = ta.crossunder(crsi, crsiUb)
bool  snapUpFromBot                         = ta.crossover(crsi, crsiDb)

cumTrMeasure                                = ta.cum(ta.tr) / math.max(1, bar_index)
volatilityMeasure                           = orderBlockFilterInput == ATR ? atrMeasure : cumTrMeasure
highVolatilityBar                           = (high - low) >= (2 * volatilityMeasure)
parsedHigh                                  = highVolatilityBar ? low : high
parsedLow                                   = highVolatilityBar ? high : low

// Visible price range for Auto-Fit Chart Scale filter (prevents old far-away bands from squashing candles)
float recentVisibleHigh                     = ta.highest(high, distantBandBarsInput)
float recentVisibleLow                      = ta.lowest(low, distantBandBarsInput)
float scaleBandBuffer                       = 4.0 * nz(atrMeasure, high - low)
float maxBandPriceAllowed                   = math.max(recentVisibleHigh, nz(trailing.top, recentVisibleHigh)) + scaleBandBuffer
float minBandPriceAllowed                   = math.min(recentVisibleLow, nz(trailing.bottom, recentVisibleLow)) - scaleBandBuffer

// Store current values into bounded arrays (capped at MAX_BUFFER_SIZE to prevent memory lag)
parsedHighs.push(parsedHigh)
parsedLows.push(parsedLow)
highs.push(high)
lows.push(low)
times.push(time)
crsiBuffer.push(nz(crsi, 50.0))
crsiDbBuffer.push(nz(crsiDb, 30.0))
crsiUbBuffer.push(nz(crsiUb, 70.0))

if parsedHighs.size() > MAX_BUFFER_SIZE
    parsedHighs.shift()
    parsedLows.shift()
    highs.shift()
    lows.shift()
    times.shift()
    crsiBuffer.shift()
    crsiDbBuffer.shift()
    crsiUbBuffer.shift()

int bufferOffset = bar_index - parsedHighs.size() + 1

//---------------------------------------------------------------------------------------------------------------------}
//HIGHER TIMEFRAME (BIG-PICTURE) TREND — NO REPAINT + AUTO TIMEFRAME SELECTION
//---------------------------------------------------------------------------------------------------------------------{
int chartTfSeconds  = timeframe.in_seconds()
string autoHtf      = chartTfSeconds <= 180 ? '15' : chartTfSeconds <= 600 ? '60' : chartTfSeconds <= 1800 ? '240' : 'D'
string htfTimeframe = autoHtfInput ? autoHtf : htfTimeframeInput

htfStructureBias(int len) =>
    var float lastPivotHigh = na
    var float lastPivotLow  = na
    var bool  highBroken    = false
    var bool  lowBroken     = false
    var int   bias          = 0
    var int   legDir        = 0
    float highestRecent     = ta.highest(len)
    float lowestRecent      = ta.lowest(len)
    bool  isNewLegHigh      = high[len] > highestRecent
    bool  isNewLegLow       = low[len]  < lowestRecent
    if isNewLegHigh
        legDir := BEARISH_LEG
    else if isNewLegLow
        legDir := BULLISH_LEG
    int legChange = ta.change(legDir)
    if legChange == -1
        lastPivotHigh := high[len]
        highBroken    := false
    else if legChange == 1
        lastPivotLow  := low[len]
        lowBroken     := false
    if not na(lastPivotHigh) and not highBroken and close > lastPivotHigh
        bias       := BULLISH
        highBroken := true
    if not na(lastPivotLow) and not lowBroken and close < lastPivotLow
        bias      := BEARISH
        lowBroken := true
    bias[1]

bool htfIsHigher    = timeframe.in_seconds(htfTimeframe) > chartTfSeconds
int  htfBiasRaw     = request.security(syminfo.tickerid, htfTimeframe, htfStructureBias(htfLengthInput), lookahead = barmerge.lookahead_on)
int  htfBias        = nz(htfBiasRaw, 0)
bool htfActive      = useHtfFilterInput and htfIsHigher

// Non-repainting higher-timeframe FVG data: [1] offset + lookahead_on = only FINISHED higher-timeframe candles
bool fvgIsCurrentTf = fairValueGapsTimeframeInput == '' or fairValueGapsTimeframeInput == timeframe.period
[hClose2, hOpen2, hTime2, hHigh1, hLow1, hTime1, hHigh3, hLow3] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[2], open[2], time[2], high[1], low[1], time[1], high[3], low[3]], lookahead = barmerge.lookahead_on)
bool fvgTfChanged   = timeframe.change(fairValueGapsTimeframeInput)

//---------------------------------------------------------------------------------------------------------------------}
//USER-DEFINED FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
leg(int size) =>
    var int legValue = 0    
    newLegHigh       = high[size] > ta.highest(size)
    newLegLow        = low[size]  < ta.lowest(size)
    
    if newLegHigh
        legValue := BEARISH_LEG
    else if newLegLow
        legValue := BULLISH_LEG
    legValue

startOfNewLeg(int legValue)      => ta.change(legValue) != 0
startOfBearishLeg(int legValue)  => ta.change(legValue) == -1
startOfBullishLeg(int legValue)  => ta.change(legValue) == +1

drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>    
    var label l_abel = na

    if modeEff == PRESENT
        l_abel.delete()

    l_abel := label.new(chart.point.new(labelTime, na, labelPrice), tag, xloc.bar_time, color = color.new(labelColor, 95), textcolor = labelColor, style = labelStyle, size = swingStructureSize, tooltip = getLabelTooltip(tag) + '\nLevel: ' + str.tostring(labelPrice, format.mintick))

drawEqualHighLow(pivot p_ivot, float level, int size, bool equalHigh) =>
    equalDisplay e_qualDisplay = equalHigh ? equalHighDisplay : equalLowDisplay
    
    string tag          = 'Double Bottom'
    color equalColor    = swingBullishColor
    string labelStyle   = label.style_label_up

    if equalHigh
        tag         := 'Double Top'
        equalColor  := swingBearishColor
        labelStyle  := label.style_label_down

    if modeEff == PRESENT
        line.delete(e_qualDisplay.l_ine)
        label.delete(e_qualDisplay.l_abel)
        
    e_qualDisplay.l_ine     := line.new(chart.point.new(p_ivot.barTime, na, p_ivot.currentLevel), chart.point.new(time[size], na, level), xloc = xloc.bar_time, color = equalColor, style = line.style_dotted, width = 2)
    labelPosition           = math.round(0.5 * (p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel    := label.new(chart.point.new(na, labelPosition, level), tag, xloc.bar_index, color = color.new(equalColor, 95), textcolor = equalColor, style = labelStyle, size = equalHighsLowsSizeInput, tooltip = getLabelTooltip(tag) + '\nTwin Price Level: ' + str.tostring(level, format.mintick))

// Helper: Check if an Order Block already covers a given price level (and optionally upgrade an early cRSI band into a full Breakout/Range band)
hasBandNearPrice(array<orderBlock> orderBlocks, float priceLevel, int bias, bool upgradeIfFound = false, bool newHasCrsi = false, bool newIsStrong = false) =>
    bool found = false
    int n = orderBlocks.size()
    if n > 0
        for i = 0 to n - 1
            orderBlock ob = orderBlocks.get(i)
            if ob.bias == bias and priceLevel >= ob.barLow - 0.5 * atr14 and priceLevel <= ob.barHigh + 0.5 * atr14
                found := true
                if upgradeIfFound
                    ob.isCrsiBand    := false
                    ob.hasCrsiOrigin := ob.hasCrsiOrigin or newHasCrsi
                    ob.isStrong      := ob.isStrong or newIsStrong
                break
    found

// Helper: Check if the launch candle (or +/-1 adjacent bar) had a cRSI Rubber-Band stretch outside the dynamic Aqua band
checkCrsiOriginAtBufferIndex(int idx, int bias) =>
    bool stretched = false
    int startK = math.max(0, idx - 1)
    int endK   = math.min(crsiBuffer.size() - 1, idx + 1)
    if endK >= startK
        for k = startK to endK
            float cVal  = crsiBuffer.get(k)
            float dbVal = crsiDbBuffer.get(k)
            float ubVal = crsiUbBuffer.get(k)
            if bias == BULLISH and (cVal <= dbVal or cVal <= 30.0)
                stretched := true
                break
            if bias == BEARISH and (cVal >= ubVal or cVal >= 70.0)
                stretched := true
                break
    stretched

// Create a 2-candle / minimum-ATR-thickness Order Block at a specific buffer index
createBandAtBufferIndex(int idx, int bias, bool isPingPong, bool isCrsiBand, bool isStrong) =>
    float rawHigh = parsedHighs.get(idx)
    float rawLow  = parsedLows.get(idx)
    int   bTime   = times.get(idx)

    // ANTI-BALLOON FIX: If the extreme candle is a tiny thin doji (< 0.35x ATR), merge with the adjacent turn candle so the band isn't razor-thin
    int   adjIdx  = math.min(parsedHighs.size() - 1, idx + 1)
    if (rawHigh - rawLow) < 0.35 * atr14 and adjIdx != idx
        if bias == BULLISH
            rawHigh := math.max(rawHigh, math.min(parsedHighs.get(adjIdx), rawLow + 0.8 * atr14))
        else
            rawLow  := math.min(rawLow, math.max(parsedLows.get(adjIdx), rawHigh - 0.8 * atr14))

    bool currentlyInside = low <= rawHigh and high >= rawLow
    bool hasCrsiOrig     = isCrsiBand or checkCrsiOriginAtBufferIndex(idx, bias)
    orderBlock.new(rawHigh, rawLow, bTime, bias, false, 0, currentlyInside, isPingPong, isCrsiBand, hasCrsiOrig, isStrong, false)

getCurrentStructure(int size, bool equalHighLow = false, bool internal = false) =>        
    currentLeg              = leg(size)
    newPivot                = startOfNewLeg(currentLeg)
    pivotLow                = startOfBullishLeg(currentLeg)
    pivotHigh               = startOfBearishLeg(currentLeg)

    // Pre-compute recent extremes over `size` bars so confirming a delayed pivot never overwrites a newer high/low
    float recentLowest      = ta.lowest(low, size)
    float recentHighest     = ta.highest(high, size)

    // Only lock in new swing points once the candle has closed (no flickering pivots)
    if newPivot and confirmed
        if pivotLow
            pivot p_ivot    = equalHighLow ? equalLow : internal ? internalLow : swingLow    

            if equalHighLow and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * atrMeasure                
                drawEqualHighLow(p_ivot, low[size], size, false)
                currentAlerts.equalLows := true

            p_ivot.lastLevel        := p_ivot.currentLevel
            p_ivot.currentLevel     := low[size]
            p_ivot.crossed          := false
            p_ivot.swept            := false
            p_ivot.pingPongStored   := false
            p_ivot.barTime          := time[size]
            p_ivot.barIndex         := bar_index[size]

            if not equalHighLow and not internal
                trailing.bottom         := math.min(p_ivot.currentLevel, recentLowest)
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastBottomTime := p_ivot.barTime

            if showSwingsEff and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', swingBullishColor, label.style_label_up)            
        else if pivotHigh
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh

            if equalHighLow and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot, high[size], size, true)
                currentAlerts.equalHighs := true               

            p_ivot.lastLevel        := p_ivot.currentLevel
            p_ivot.currentLevel     := high[size]
            p_ivot.crossed          := false
            p_ivot.swept            := false
            p_ivot.pingPongStored   := false
            p_ivot.barTime          := time[size]
            p_ivot.barIndex         := bar_index[size]

            if not equalHighLow and not internal
                trailing.top            := math.max(p_ivot.currentLevel, recentHighest)
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastTopTime    := p_ivot.barTime

            if showSwingsEff and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', swingBearishColor, label.style_label_down)

// V7 1-BAR EARLY HORIZONTAL cRSI SNAP-BACK BANDS:
// Draws a horizontal Buyer/Seller Band immediately on Candle #1 when cRSI hooks back across its dynamic Aqua Band (db / ub),
// anchoring to the true 5-bar swing trough/peak so you get the band 7 candles (14 mins on 2m) earlier than an 8-bar pivot!
detectCrsiSnapBands() =>
    if showInternalOBEff and showCrsiBandsInput and confirmed and parsedHighs.size() >= 2
        int bufSize      = parsedHighs.size()
        int lookbackBars = math.min(5, bufSize)
        bool hasVolNow   = na(volume) or na(avgVol20) or volume >= 0.85 * avgVol20 or volume[1] >= 0.85 * avgVol20
        bool bullCandle  = close > open or (high > low and (close - low) >= 0.6 * (high - low))
        bool bearCandle  = close < open or (high > low and (high - close) >= 0.6 * (high - low))

        // 1. Early Bullish cRSI Snap-Back Floor Band (cRSI hooked back above Dynamic Lower Aqua Band `crsiDb`)
        if snapUpFromBot and bullCandle and hasVolNow
            int minBufIdx = bufSize - 1
            float floorPrice = parsedLows.get(minBufIdx)
            for k = 1 to lookbackBars - 1
                int candIdx = bufSize - 1 - k
                float candLow = parsedLows.get(candIdx)
                if candLow <= floorPrice
                    floorPrice := candLow
                    minBufIdx  := candIdx
            bool isKijunBacked = close >= baseLine26 - 0.5 * atr14
            if not hasBandNearPrice(internalOrderBlocks, floorPrice, BULLISH, false, true, isKijunBacked)
                orderBlock crsiBuy = createBandAtBufferIndex(minBufIdx, BULLISH, false, true, isKijunBacked)
                if internalOrderBlocks.size() >= 100
                    internalOrderBlocks.pop()
                internalOrderBlocks.unshift(crsiBuy)
                currentAlerts.crsiBuyBand := true
            else
                currentAlerts.inBandBullDot := true

        // 2. Early Bearish cRSI Snap-Back Ceiling Band (cRSI hooked back below Dynamic Upper Aqua Band `crsiUb`)
        if snapDownFromTop and bearCandle and hasVolNow
            int maxBufIdx = bufSize - 1
            float ceilPrice = parsedHighs.get(maxBufIdx)
            for k = 1 to lookbackBars - 1
                int candIdx = bufSize - 1 - k
                float candHigh = parsedHighs.get(candIdx)
                if candHigh >= ceilPrice
                    ceilPrice := candHigh
                    maxBufIdx := candIdx
            bool isKijunBacked = close <= baseLine26 + 0.5 * atr14
            if not hasBandNearPrice(internalOrderBlocks, ceilPrice, BEARISH, false, true, isKijunBacked)
                orderBlock crsiSell = createBandAtBufferIndex(maxBufIdx, BEARISH, false, true, isKijunBacked)
                if internalOrderBlocks.size() >= 100
                    internalOrderBlocks.pop()
                internalOrderBlocks.unshift(crsiSell)
                currentAlerts.crsiSellBand := true
            else
                currentAlerts.inBandBearDot := true

// V6/V7 TRUE PING-PONG CONSOLIDATION BANDS:
detectPingPongBands() =>
    if showInternalOBEff and showPingPongBandsInput and confirmed
        bool hasBothBounds = not na(internalLow.currentLevel) and not internalLow.crossed and not na(internalHigh.currentLevel) and not internalHigh.crossed and internalHigh.currentLevel > internalLow.currentLevel

        // 1. Check if confirmed Minor Floor (`internalLow`) held in a true consolidation range or Sweep
        if not na(internalLow.currentLevel) and not internalLow.crossed and not internalLow.pingPongStored
            bool isConsolidationFloor = (hasBothBounds and internalHigh.barIndex > internalLow.barIndex and close < internalHigh.currentLevel) or internalLow.swept or currentAlerts.equalLows
            bool bouncedHard          = (close - internalLow.currentLevel) >= 1.2 * atr14 and close > open
            if isConsolidationFloor and bouncedHard
                internalLow.pingPongStored := true
                int pivotBufIdx = internalLow.barIndex - bufferOffset
                if pivotBufIdx >= 0 and pivotBufIdx < parsedLows.size()
                    bool hasVol        = na(volume) or na(avgVol20) or volume >= 1.15 * avgVol20
                    bool isKijunBacked = close >= baseLine26 - 0.5 * atr14
                    bool hasCrsiOrig   = checkCrsiOriginAtBufferIndex(pivotBufIdx, BULLISH)
                    bool strongFloor   = internalLow.swept or currentAlerts.equalLows or (hasVol and isKijunBacked) or (hasCrsiOrig and isKijunBacked)
                    bool passFilter    = not filterWeakMiniBandsInput or strongFloor or hasVol or hasCrsiOrig
                    if passFilter and not hasBandNearPrice(internalOrderBlocks, internalLow.currentLevel, BULLISH, true, hasCrsiOrig, strongFloor)
                        orderBlock ppBuy = createBandAtBufferIndex(pivotBufIdx, BULLISH, true, false, strongFloor)
                        if internalOrderBlocks.size() >= 100
                            internalOrderBlocks.pop()
                        internalOrderBlocks.unshift(ppBuy)
                        currentAlerts.pingPongBuyBand := true

        // 2. Check if confirmed Minor Ceiling (`internalHigh`) held in a true consolidation range or Sweep
        if not na(internalHigh.currentLevel) and not internalHigh.crossed and not internalHigh.pingPongStored
            bool isConsolidationCeil = (hasBothBounds and internalLow.barIndex > internalHigh.barIndex and close > internalLow.currentLevel) or internalHigh.swept or currentAlerts.equalHighs
            bool rejectedHard        = (internalHigh.currentLevel - close) >= 1.2 * atr14 and close < open
            if isConsolidationCeil and rejectedHard
                internalHigh.pingPongStored := true
                int pivotBufIdx = internalHigh.barIndex - bufferOffset
                if pivotBufIdx >= 0 and pivotBufIdx < parsedHighs.size()
                    bool hasVol        = na(volume) or na(avgVol20) or volume >= 1.15 * avgVol20
                    bool isKijunBacked = close <= baseLine26 + 0.5 * atr14
                    bool hasCrsiOrig   = checkCrsiOriginAtBufferIndex(pivotBufIdx, BEARISH)
                    bool strongCeiling = internalHigh.swept or currentAlerts.equalHighs or (hasVol and isKijunBacked) or (hasCrsiOrig and isKijunBacked)
                    bool passFilter    = not filterWeakMiniBandsInput or strongCeiling or hasVol or hasCrsiOrig
                    if passFilter and not hasBandNearPrice(internalOrderBlocks, internalHigh.currentLevel, BEARISH, true, hasCrsiOrig, strongCeiling)
                        orderBlock ppSell = createBandAtBufferIndex(pivotBufIdx, BEARISH, true, false, strongCeiling)
                        if internalOrderBlocks.size() >= 100
                            internalOrderBlocks.pop()
                        internalOrderBlocks.unshift(ppSell)
                        currentAlerts.pingPongSellBand := true
                
drawStructure(pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize) =>    
    var line l_ine      = line.new(na, na, na, na, xloc = xloc.bar_time)
    var label l_abel    = label.new(na, na)

    if modeEff == PRESENT
        l_ine.delete()
        l_abel.delete()

    l_ine   := line.new(chart.point.new(p_ivot.barTime, na, p_ivot.currentLevel), chart.point.new(time, na, p_ivot.currentLevel), xloc = xloc.bar_time, color = structureColor, style = lineStyle, width = lineStyle == line.style_solid ? 2 : 1)
    l_abel  := label.new(chart.point.new(na, math.round(0.5 * (p_ivot.barIndex + bar_index)), p_ivot.currentLevel), tag, xloc.bar_index, color = color.new(structureColor, 95), textcolor = structureColor, style = labelStyle, size = labelSize, tooltip = getLabelTooltip(tag) + '\nBreakout Price: ' + str.tostring(p_ivot.currentLevel, format.mintick))

// Keep only the most recent N sweeps on the chart
trimSweeps() =>
    while sweepLines.size() > maxSweepsInput
        line.delete(sweepLines.shift())
    while sweepLabels.size() > maxSweepsInput
        label.delete(sweepLabels.shift())

// Detect Wick Liquidity Sweeps (Stop Hunts that close back inside the range).
detectLiquiditySweeps(bool internal, bool draw) =>
    pivot highPivot = internal ? internalHigh : swingHigh
    pivot lowPivot  = internal ? internalLow  : swingLow
    color bullColor = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput
    color bearColor = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput

    // Bearish Sweep: Wick pokes above High pivot, but candle closes back below it
    if confirmed and not na(highPivot.currentLevel) and not highPivot.crossed and not highPivot.swept
        if high > highPivot.currentLevel and close < highPivot.currentLevel
            highPivot.swept := true
            if internal
                currentAlerts.miniBearishSweep := true
            else
                currentAlerts.bearishSweep     := true
            if draw
                string sweepTag = internal ? 'Mini Sweep ↓' : 'Sweep ↓'
                sweepLines.push(line.new(chart.point.new(highPivot.barTime, na, highPivot.currentLevel), chart.point.new(time, na, highPivot.currentLevel), xloc = xloc.bar_time, color = bearColor, style = line.style_dotted))
                sweepLabels.push(label.new(chart.point.new(time, na, high), sweepTag, xloc.bar_time, color = color.new(bearColor, 95), textcolor = bearColor, style = label.style_label_down, size = sweepLabelSizeInput, tooltip = getLabelTooltip(sweepTag) + '\nSwept Level: ' + str.tostring(highPivot.currentLevel, format.mintick)))
                trimSweeps()

    // Bullish Sweep: Wick pokes below Low pivot, but candle closes back above it
    if confirmed and not na(lowPivot.currentLevel) and not lowPivot.crossed and not lowPivot.swept
        if low < lowPivot.currentLevel and close > lowPivot.currentLevel
            lowPivot.swept := true
            if internal
                currentAlerts.miniBullishSweep := true
            else
                currentAlerts.bullishSweep     := true
            if draw
                string sweepTag = internal ? 'Mini Sweep ↑' : 'Sweep ↑'
                sweepLines.push(line.new(chart.point.new(lowPivot.barTime, na, lowPivot.currentLevel), chart.point.new(time, na, lowPivot.currentLevel), xloc = xloc.bar_time, color = bullColor, style = line.style_dotted))
                sweepLabels.push(label.new(chart.point.new(time, na, low), sweepTag, xloc.bar_time, color = color.new(bullColor, 95), textcolor = bullColor, style = label.style_label_up, size = sweepLabelSizeInput, tooltip = getLabelTooltip(sweepTag) + '\nSwept Level: ' + str.tostring(lowPivot.currentLevel, format.mintick)))
                trimSweeps()

// MITIGATION WITH STOP-HUNT BUFFER: A band only breaks when price exceeds the back edge by `obBufferInput * atr14`
deleteOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    float obBuffer = obBufferInput * atr14
    int index = orderBlocks.size() - 1

    while index >= 0
        orderBlock eachOrderBlock = orderBlocks.get(index)
        bool crossedOrderBlock = false
        
        if bearishOrderBlockMitigationSource > (eachOrderBlock.barHigh + obBuffer) and eachOrderBlock.bias == BEARISH
            crossedOrderBlock := true
            if internal
                currentAlerts.internalBearishOrderBlock := true
            else
                currentAlerts.swingBearishOrderBlock    := true
        else if bullishOrderBlockMitigationSource < (eachOrderBlock.barLow - obBuffer) and eachOrderBlock.bias == BULLISH
            crossedOrderBlock := true
            if internal
                currentAlerts.internalBullishOrderBlock := true
            else
                currentAlerts.swingBullishOrderBlock    := true

        if crossedOrderBlock
            if showBreakerBlocksInput and not eachOrderBlock.isBreaker
                eachOrderBlock.bias       := -eachOrderBlock.bias
                eachOrderBlock.isBreaker  := true
                eachOrderBlock.isPingPong := false
                eachOrderBlock.isCrsiBand := false
                eachOrderBlock.touches    := 0
                eachOrderBlock.insideBand := true
                eachOrderBlock.isSlammed  := false
            else
                orderBlocks.remove(index)
        index -= 1

// Track how many times price pulls back into each SURVIVING band + detect violent >=2.5x ATR 3-bar slams + detect In-Band cRSI Turn Dots!
updateOrderBlockTouches(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    int n = orderBlocks.size()
    if n > 0
        float slamDown3   = nz(high[3], high) - low
        float slamUp3     = high - nz(low[3], low)
        float obBuf       = obBufferInput * atr14
        float recentLow3  = math.min(low, math.min(nz(low[1], low), nz(low[2], low)))
        float recentHigh3 = math.max(high, math.max(nz(high[1], high), nz(high[2], high)))
        for i = 0 to n - 1
            orderBlock ob = orderBlocks.get(i)
            bool touchingNow    = low <= ob.barHigh and high >= ob.barLow
            bool nearBandRecent = recentLow3 <= ob.barHigh + 0.35 * atr14 and recentHigh3 >= ob.barLow - 0.35 * atr14
            if touchingNow
                if not ob.insideBand and time > ob.barTime
                    ob.touches    += 1
                    ob.insideBand := true
                    // Backtest Finding: When price slams >= 2.5x ATR over 3 bars into a Mini Band, burst risk triples
                    if internal and ((ob.bias == BULLISH and slamDown3 >= 2.5 * atr14) or (ob.bias == BEARISH and slamUp3 >= 2.5 * atr14))
                        ob.isSlammed := true
            else
                ob.insideBand := false

            // V7 IN-BAND cRSI TURN DOT: Fires when a cRSI Snap-Back Hook occurs inside or within 3 bars of touching an active surviving band!
            if confirmed and nearBandRecent and time > ob.barTime and not ob.isBreaker
                if ob.bias == BULLISH and snapUpFromBot and close >= ob.barLow - obBuf
                    currentAlerts.inBandBullDot := true
                else if ob.bias == BEARISH and snapDownFromTop and close <= ob.barHigh + obBuf
                    currentAlerts.inBandBearDot := true

storeOrdeBlock(pivot p_ivot, bool internal, int bias) =>
    if (not internal and showSwingOBEff) or (internal and showInternalOBEff)
        int startIdx = math.max(0, p_ivot.barIndex - bufferOffset)
        int endIdx   = parsedHighs.size()

        if endIdx > startIdx
            array<float> a_rray = na
            int parsedIndex = na

            if bias == BEARISH
                a_rray      := parsedHighs.slice(startIdx, endIdx)
                parsedIndex := startIdx + a_rray.lastindexof(a_rray.max())  
            else
                a_rray      := parsedLows.slice(startIdx, endIdx)
                parsedIndex := startIdx + a_rray.lastindexof(a_rray.min())                        

            // V7 INSTITUTIONAL STRENGTH + 26-BAR BASE EQUILIBRIUM + cRSI RUBBER-BAND ORIGIN CHECK:
            float launchExtreme     = bias == BULLISH ? parsedLows.get(parsedIndex) : parsedHighs.get(parsedIndex)
            float impulseMove       = math.abs(close - launchExtreme)
            float breakoutBody      = math.abs(close - open)
            bool  hasVolume         = na(volume) or na(avgVol20) or volume >= 1.1 * avgVol20 or volume[1] >= 1.15 * avgVol20
            bool  hasMomentum       = breakoutBody >= 0.8 * atr14 or impulseMove >= 1.4 * atr14
            bool  hasSweepOrTrend   = (bias == BULLISH and (internalLow.swept or swingLow.swept or swingTrend.bias == BULLISH)) or (bias == BEARISH and (internalHigh.swept or swingHigh.swept or swingTrend.bias == BEARISH))
            bool  hasCrsiOrig       = checkCrsiOriginAtBufferIndex(parsedIndex, bias)
            bool  isKijunBacked     = (bias == BULLISH and close >= baseLine26) or (bias == BEARISH and close <= baseLine26)

            bool  isStrongBand      = ((hasVolume and hasMomentum) or (hasMomentum and hasSweepOrTrend) or (hasCrsiOrig and hasMomentum)) and isKijunBacked
            bool  passMiniFilter    = not internal or not filterWeakMiniBandsInput or hasMomentum or hasVolume or hasSweepOrTrend or hasCrsiOrig

            array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
            // If an Early `🎯 cRSI` Band was already drawn at this exact pivot, `hasBandNearPrice` upgrades it in-place instead of duplicating!
            if passMiniFilter and not hasBandNearPrice(orderBlocks, launchExtreme, bias, true, hasCrsiOrig, isStrongBand)
                orderBlock o_rderBlock = createBandAtBufferIndex(parsedIndex, bias, false, false, isStrongBand)
                if orderBlocks.size() >= 100
                    orderBlocks.pop()
                orderBlocks.unshift(o_rderBlock)

getBandTooltip(orderBlock ob, bool internal, bool isKnifeRisk) =>
    string tierName = ob.isCrsiBand ? '🎯 Early cRSI Rubber-Band ' : ob.isPingPong ? '🏓 Ping-Pong Range ' : internal ? 'Minor ' : 'MAJOR '
    string roleName = ob.isBreaker ? (ob.bias == BULLISH ? 'Bullish Breaker (Flipped Support)' : 'Bearish Breaker (Flipped Resistance)') : (ob.bias == BULLISH ? tierName + 'Buyer Band (Demand Floor)' : tierName + 'Seller Band (Supply Ceiling)')
    string status   = ob.touches == 0 ? '✨ FRESH (Untested — Highest Probability!)' : ob.touches == 1 ? '✅ TESTED 1x (Still Valid — Watch for Confirmation)' : '⚠️ TESTED ' + str.tostring(ob.touches) + 'x (Weaker — Many Orders Already Filled)'
    string crsiNote = ob.hasCrsiOrigin ? '🎯 Launched from cRSI Rubber-Band Snap (80.0% Hold / 6.7% Burst on Gold)\n' : ''
    string baseStat = (ob.bias == BULLISH and ob.barHigh >= baseLine26 - 0.5 * atr14) or (ob.bias == BEARISH and ob.barLow <= baseLine26 + 0.5 * atr14) ? '✅ Reinforced by 26-Bar Base Line' : isKnifeRisk ? '⚠️ Below/Against 26-Bar Base Line or Hit by >=2.5x ATR Slam (Wait for In-Band 🟢/🟡 Dot or Sweep!)' : 'Standard Structure Band'
    string strength = ob.isStrong ? '💪 STRONG (Backed by Volume + Momentum + Base Line)' : baseStat
    string action   = ob.isCrsiBand ? (ob.bias == BULLISH ? '• Early cRSI Band (Drawn 7 Bars Early): Get ready to Buy when price pulls back into this floor and prints a 🟢 Turn Dot or Mini Sweep ↑.' : '• Early cRSI Band (Drawn 7 Bars Early): Get ready to Sell when price bounces into this ceiling and prints a 🟡 Turn Dot or Mini Sweep ↓.') : ob.isPingPong ? (ob.bias == BULLISH ? '• Ping-Pong Play: Buy bounce inside this floor band -> Take Profit at the Top Sell Band.' : '• Ping-Pong Play: Sell rejection inside this ceiling band -> Take Profit at the Bottom Buy Band.') : (ob.bias == BULLISH ? '• How to trade: Wait for a controlled pullback into this band and look for an In-Band 🟢 Dot, "Mini Sweep ↑", or "U-Turn ↑" to go LONG.' : '• How to trade: Wait for a controlled bounce into this band and look for an In-Band 🟡 Dot, "Mini Sweep ↓", or "U-Turn ↓" to go SHORT.')
    '🏦 ' + roleName + '\n━━━━━━━━━━━━━━━━━━━━\n• Freshness: ' + status + '\n• Quality: ' + strength + '\n' + (crsiNote != '' ? '• cRSI Confluence: ' + crsiNote : '') + '• Band Range: ' + str.tostring(ob.barLow, format.mintick) + ' to ' + str.tostring(ob.barHigh, format.mintick) + '\n' + action

// V7 SEPARATE BUY & SELL QUOTA + cRSI ORIGIN BADGES + SLAM WARNING TAGS
drawOrderBlocks(bool internal = false) =>        
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    orderBlocksSize = orderBlocks.size()
    array<box> b_oxes    = internal ? internalOrderBlocksBoxes : swingOrderBlocksBoxes
    array<label> l_abels = internal ? internalOrderBlocksLabels : swingOrderBlocksLabels

    // Clear previous band freshness labels and recreate on the latest bar so they are NEVER garbage-collected by TradingView's 500-label limit
    if l_abels.size() > 0
        for i = 0 to l_abels.size() - 1
            label.delete(l_abels.get(i))
        l_abels.clear()

    if orderBlocksSize > 0        
        int maxPerSide = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        int bullDrawn  = 0
        int bearDrawn  = 0
        int drawnCount = 0

        for i = 0 to orderBlocksSize - 1
            if drawnCount >= b_oxes.size() or (bullDrawn >= maxPerSide and bearDrawn >= maxPerSide)
                break
            orderBlock eachOrderBlock = orderBlocks.get(i)

            // Backtest-proven Knife/Slam evaluation on the active bar:
            bool lostBaseLine = internal and ((eachOrderBlock.bias == BULLISH and close < baseLine26 - 1.5 * atr14 and eachOrderBlock.barHigh < baseLine26 - 0.5 * atr14) or (eachOrderBlock.bias == BEARISH and close > baseLine26 + 1.5 * atr14 and eachOrderBlock.barLow > baseLine26 + 0.5 * atr14))
            bool isKnifeRisk  = internal and (eachOrderBlock.isSlammed or lostBaseLine)
            bool passWeakHide = not (internal and hideWeakenedBandsInput and isKnifeRisk)

            bool sideQuotaOk  = eachOrderBlock.bias == BULLISH ? (bullDrawn < maxPerSide) : (bearDrawn < maxPerSide)
            bool withinScale  = not hideDistantBandsInput or (eachOrderBlock.barLow <= maxBandPriceAllowed and eachOrderBlock.barHigh >= minBandPriceAllowed)

            if sideQuotaOk and withinScale and passWeakHide
                orderBlockColor = styleInput == MONOCHROME ? (eachOrderBlock.bias == BEARISH ? color.new(MONO_BEARISH, 80) : color.new(MONO_BULLISH, 80)) : internal ? (eachOrderBlock.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor) : (eachOrderBlock.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor)

                box b_ox = b_oxes.get(drawnCount)
                b_ox.set_top_left_point(    chart.point.new(eachOrderBlock.barTime, na, eachOrderBlock.barHigh))
                b_ox.set_bottom_right_point(chart.point.new(last_bar_time, na, eachOrderBlock.barLow))        
                b_ox.set_border_color(      eachOrderBlock.isBreaker ? ORANGE : (eachOrderBlock.isPingPong or eachOrderBlock.isCrsiBand) ? color.new(orderBlockColor, 20) : (internal ? na : orderBlockColor))
                b_ox.set_border_style(      eachOrderBlock.isCrsiBand ? line.style_dotted : (eachOrderBlock.isBreaker or eachOrderBlock.isPingPong) ? line.style_dashed : line.style_solid)
                b_ox.set_bgcolor(           orderBlockColor)

                if showBandLabelsInput
                    string prefixTag   = eachOrderBlock.isCrsiBand ? (eachOrderBlock.bias == BULLISH ? '🎯 cRSI Buy' : '🎯 cRSI Sell') : eachOrderBlock.isPingPong ? (eachOrderBlock.bias == BULLISH ? '🏓 Range Buy' : '🏓 Range Sell') : internal ? (eachOrderBlock.bias == BULLISH ? 'Buy Band' : 'Sell Band') : (eachOrderBlock.bias == BULLISH ? 'MAJOR Buy' : 'MAJOR Sell')
                    string warnIcon    = (eachOrderBlock.touches >= 2 and not eachOrderBlock.isSlammed) ? ' ⚠️' : ''
                    string freshTag    = eachOrderBlock.isBreaker ? 'Breaker' : eachOrderBlock.touches == 0 ? 'Fresh ✨' : eachOrderBlock.touches == 1 ? 'Tested 1x' : 'Tested ' + str.tostring(eachOrderBlock.touches) + 'x' + warnIcon
                    string crsiBadge   = (not eachOrderBlock.isCrsiBand and eachOrderBlock.hasCrsiOrigin) ? ' 🎯' : ''
                    string strengthTag = eachOrderBlock.isSlammed ? ' ⚠️ Slam' : (eachOrderBlock.isStrong ? ' 💪' : '') + crsiBadge
                    color  tagColor    = eachOrderBlock.isBreaker ? ORANGE : color.new(orderBlockColor, 0)
                    float  midPrice    = math.avg(eachOrderBlock.barHigh, eachOrderBlock.barLow)
                    label  l_bl        = label.new(chart.point.new(last_bar_time, na, midPrice), prefixTag + ' • ' + freshTag + strengthTag, xloc = xloc.bar_time, color = color.new(orderBlockColor, 85), textcolor = tagColor, style = label.style_label_left, size = bandLabelSizeInput, tooltip = getBandTooltip(eachOrderBlock, internal, isKnifeRisk))
                    l_abels.push(l_bl)

                if eachOrderBlock.bias == BULLISH
                    bullDrawn += 1
                else
                    bearDrawn += 1
                drawnCount += 1

        // Hide any unused pre-allocated boxes so stale or far-away bands don't linger or squash the chart
        if drawnCount < b_oxes.size()
            for i = drawnCount to b_oxes.size() - 1
                box unusedBox = b_oxes.get(i)
                unusedBox.set_top_left_point(chart.point.new(na, na, na))
                unusedBox.set_bottom_right_point(chart.point.new(na, na, na))
    else
        for eachBox in b_oxes
            eachBox.set_top_left_point(chart.point.new(na, na, na))
            eachBox.set_bottom_right_point(chart.point.new(na, na, na))

displayStructure(bool internal = false) =>
    var bool bullishBar = true
    var bool bearishBar = true

    if internalFilterConfluenceInput
        float bodySize  = math.abs(close - open)
        float upperWick = high - math.max(close, open)
        float lowerWick = math.min(close, open) - low
        bullishBar := close > open and (bodySize + lowerWick) > upperWick
        bearishBar := close < open and (bodySize + upperWick) > lowerWick

    // Optional V7 Anti-Chase Filter: Skip minor breakout labels if cRSI is already maxed out (>=75 on bull breakout or <=25 on bear breakout)
    bool bullNotExhausted = not (internal and filterExhaustedCrsiInput and nz(crsi, 50.0) >= 75.0)
    bool bearNotExhausted = not (internal and filterExhaustedCrsiInput and nz(crsi, 50.0) <= 25.0)
    
    pivot p_ivot    = internal ? internalHigh : swingHigh
    trend t_rend    = internal ? internalTrend : swingTrend

    lineStyle       = internal ? line.style_dashed : line.style_solid
    labelSize       = internal ? internalStructureSize : swingStructureSize
    string prefix   = (not internal and showMajorPrefixInput) ? 'MAJOR ' : ''

    extraCondition  = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullishBar and bullNotExhausted : true
    bullishColor    = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput
    bullishColor    := fadeCounterTrendInput and htfActive and htfBias == BEARISH ? color.new(bullishColor, 70) : bullishColor

    bool bullCross  = ta.crossover(close, p_ivot.currentLevel)
    if bullCross and confirmed and not p_ivot.crossed and extraCondition
        bool isChoch = t_rend.bias == BEARISH
        string tag   = prefix + (isChoch ? 'U-Turn ↑' : 'New High ↑')

        if internal
            currentAlerts.internalBullishCHoCH  := isChoch
            currentAlerts.internalBullishBOS    := not isChoch
        else
            currentAlerts.swingBullishCHoCH     := isChoch
            currentAlerts.swingBullishBOS       := not isChoch

        p_ivot.crossed  := true
        t_rend.bias     := BULLISH

        // Anchor the active Roof/Floor range when a MAJOR bullish breakout occurs
        if not internal and not na(swingLow.currentLevel)
            trailing.bottom         := math.min(swingLow.currentLevel, low)
            trailing.lastBottomTime := swingLow.barTime
            trailing.barTime        := swingLow.barTime
            trailing.barIndex       := swingLow.barIndex
            trailing.top            := high
            trailing.lastTopTime    := time

        displayCondition = internal ? showInternalsEff and (showInternalBullInput == ALL or (showInternalBullInput == BOS and not isChoch) or (showInternalBullInput == CHOCH and isChoch)) : showStructureEff and (showSwingBullInput == ALL or (showSwingBullInput == BOS and not isChoch) or (showSwingBullInput == CHOCH and isChoch))

        if displayCondition                        
            drawStructure(p_ivot, tag, bullishColor, lineStyle, label.style_label_down, labelSize)

        if (internal and showInternalOBEff) or (not internal and showSwingOBEff)
            storeOrdeBlock(p_ivot, internal, BULLISH)

    p_ivot          := internal ? internalLow : swingLow    
    extraCondition  := internal ? internalLow.currentLevel != swingLow.currentLevel and bearishBar and bearNotExhausted : true
    bearishColor    = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput
    bearishColor    := fadeCounterTrendInput and htfActive and htfBias == BULLISH ? color.new(bearishColor, 70) : bearishColor

    bool bearCross  = ta.crossunder(close, p_ivot.currentLevel)
    if bearCross and confirmed and not p_ivot.crossed and extraCondition
        bool isChoch = t_rend.bias == BULLISH
        string tag   = prefix + (isChoch ? 'U-Turn ↓' : 'New Low ↓')

        if internal
            currentAlerts.internalBearishCHoCH  := isChoch
            currentAlerts.internalBearishBOS    := not isChoch
        else
            currentAlerts.swingBearishCHoCH     := isChoch
            currentAlerts.swingBearishBOS       := not isChoch

        p_ivot.crossed := true
        t_rend.bias    := BEARISH

        // Anchor the active Roof/Floor range when a MAJOR bearish breakout occurs
        if not internal and not na(swingHigh.currentLevel)
            trailing.top            := math.max(swingHigh.currentLevel, high)
            trailing.lastTopTime    := swingHigh.barTime
            trailing.barTime        := swingHigh.barTime
            trailing.barIndex       := swingHigh.barIndex
            trailing.bottom         := low
            trailing.lastBottomTime := time

        displayCondition = internal ? showInternalsEff and (showInternalBearInput == ALL or (showInternalBearInput == BOS and not isChoch) or (showInternalBearInput == CHOCH and isChoch)) : showStructureEff and (showSwingBearInput == ALL or (showSwingBearInput == BOS and not isChoch) or (showSwingBearInput == CHOCH and isChoch))
        
        if displayCondition                        
            drawStructure(p_ivot, tag, bearishColor, lineStyle, label.style_label_up, labelSize)

        if (internal and showInternalOBEff) or (not internal and showSwingOBEff)
            storeOrdeBlock(p_ivot, internal, BEARISH)

fairValueGapBox(int leftTime, int rightTime, float topPrice, float bottomPrice, color boxColor) =>
    box.new(chart.point.new(leftTime, na, topPrice), chart.point.new(rightTime + fairValueGapsExtendInput * (time - time[1]), na, bottomPrice), xloc = xloc.bar_time, border_color = boxColor, bgcolor = boxColor)

deleteFairValueGaps() =>
    int index = fairValueGaps.size() - 1
    while index >= 0
        fairValueGap eachFairValueGap = fairValueGaps.get(index)
        bool isMitigated = (eachFairValueGap.bias == BULLISH and low <= eachFairValueGap.bottom) or (eachFairValueGap.bias == BEARISH and high >= eachFairValueGap.top)

        if isMitigated
            eachFairValueGap.topBox.delete()
            eachFairValueGap.bottomBox.delete()
            fairValueGaps.remove(index)
        else if shrinkFairValueGapsInput
            if eachFairValueGap.bias == BULLISH and low < eachFairValueGap.top
                eachFairValueGap.top := low
                float mid = math.avg(eachFairValueGap.top, eachFairValueGap.bottom)
                eachFairValueGap.topBox.set_top(eachFairValueGap.top)
                eachFairValueGap.topBox.set_bottom(mid)
                eachFairValueGap.bottomBox.set_top(mid)
            else if eachFairValueGap.bias == BEARISH and high > eachFairValueGap.bottom
                eachFairValueGap.bottom := high
                float mid = math.avg(eachFairValueGap.top, eachFairValueGap.bottom)
                eachFairValueGap.topBox.set_bottom(mid)
                eachFairValueGap.bottomBox.set_top(mid)
                eachFairValueGap.bottomBox.set_bottom(eachFairValueGap.bottom)
        index -= 1
    
drawFairValueGaps() => 
    lastClose   = fvgIsCurrentTf ? close[1] : hClose2
    lastOpen    = fvgIsCurrentTf ? open[1]  : hOpen2
    lastTime    = fvgIsCurrentTf ? time[1]  : hTime2
    currentHigh = fvgIsCurrentTf ? high     : hHigh1
    currentLow  = fvgIsCurrentTf ? low      : hLow1
    currentTime = fvgIsCurrentTf ? time     : hTime1
    last2High   = fvgIsCurrentTf ? high[2]  : hHigh3
    last2Low    = fvgIsCurrentTf ? low[2]   : hLow3

    barDeltaPercent     = (lastClose - lastOpen) / (lastOpen * 100)
    bool newTimeframe   = fvgIsCurrentTf ? true : fvgTfChanged
    float cumDelta      = ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0.0))
    float threshold     = fairValueGapsThresholdInput ? (cumDelta / math.max(1, bar_index)) * 2.0 : 0.0

    bullishFairValueGap = confirmed and currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFairValueGap = confirmed and currentHigh < last2Low and lastClose < last2Low and -barDeltaPercent > threshold and newTimeframe

    if bullishFairValueGap
        currentAlerts.bullishFairValueGap := true
        float mid = math.avg(currentLow, last2High)
        fairValueGaps.unshift(fairValueGap.new(currentLow, last2High, BULLISH, fairValueGapBox(lastTime, currentTime, currentLow, mid, fairValueGapBullishColor), fairValueGapBox(lastTime, currentTime, mid, last2High, fairValueGapBullishColor)))
    if bearishFairValueGap
        currentAlerts.bearishFairValueGap := true
        float mid = math.avg(last2Low, currentHigh)
        fairValueGaps.unshift(fairValueGap.new(last2Low, currentHigh, BEARISH, fairValueGapBox(lastTime, currentTime, last2Low, mid, fairValueGapBearishColor), fairValueGapBox(lastTime, currentTime, mid, currentHigh, fairValueGapBearishColor)))

getStyle(string style) =>
    switch style
        SOLID  => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted
        => line.style_solid

drawLevels(string timeframe, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], time], lookahead = barmerge.lookahead_on)

    float parsedTop         = sameTimeframe ? high : topLevel
    float parsedBottom      = sameTimeframe ? low : bottomLevel    

    int parsedLeftTime      = sameTimeframe ? time : leftTime
    int parsedRightTime     = sameTimeframe ? time : rightTime

    int parsedTopTime       = time
    int parsedBottomTime    = time

    if not sameTimeframe
        int leftIndex               = times.binary_search_rightmost(parsedLeftTime)
        int rightIndex              = times.binary_search_rightmost(parsedRightTime)

        array<int> timeArray        = times.slice(leftIndex, rightIndex)
        array<float> topArray       = highs.slice(leftIndex, rightIndex)
        array<float> bottomArray    = lows.slice(leftIndex, rightIndex)

        parsedTopTime               := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max())) : initialTime
        parsedBottomTime            := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : initialTime

    string periodName       = timeframe == 'D' ? 'Yesterday (Previous Day)' : timeframe == 'W' ? 'Last Week (Previous Week)' : 'Last Month (Previous Month)'
    var line topLine        = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line bottomLine     = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var label topLabel      = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}H', timeframe), color = color.new(levelColor, 95), textcolor = levelColor, size = size.normal, style = label.style_label_left)
    var label bottomLabel   = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}L', timeframe), color = color.new(levelColor, 95), textcolor = levelColor, size = size.normal, style = label.style_label_left)

    topLine.set_first_point(    chart.point.new(parsedTopTime, na, parsedTop))
    topLine.set_second_point(   chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedTop))   
    topLabel.set_point(         chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedTop))
    topLabel.set_tooltip(       '📅 P' + timeframe + 'H = ' + periodName + ' HIGH (' + str.tostring(parsedTop, format.mintick) + ')\n━━━━━━━━━━━━━━━━━━━━\n• Major ceiling from ' + periodName + '. Watch for a breakout or a Sweep ↓ stop-hunt here.')

    bottomLine.set_first_point( chart.point.new(parsedBottomTime, na, parsedBottom))    
    bottomLine.set_second_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedBottom))
    bottomLabel.set_point(      chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedBottom))
    bottomLabel.set_tooltip(    '📅 P' + timeframe + 'L = ' + periodName + ' LOW (' + str.tostring(parsedBottom, format.mintick) + ')\n━━━━━━━━━━━━━━━━━━━━\n• Major floor from ' + periodName + '. Watch for a bounce or a Sweep ↑ stop-hunt here.')

higherTimeframe(string timeframe) => timeframe.in_seconds() > timeframe.in_seconds(timeframe)

updateTrailingExtremes() =>
    trailing.top            := math.max(high, trailing.top)
    trailing.lastTopTime    := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom         := math.min(low, trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

drawHighLowSwings() =>
    var line topLine        = line.new(na, na, na, na, color = swingBearishColor, xloc = xloc.bar_time, width = 2)
    var line bottomLine     = line.new(na, na, na, na, color = swingBullishColor, xloc = xloc.bar_time, width = 2)
    var label topLabel      = label.new(na, na, color = color.new(swingBearishColor, 95), textcolor = swingBearishColor, xloc = xloc.bar_time, style = label.style_label_down)
    var label bottomLabel   = label.new(na, na, color = color.new(swingBullishColor, 95), textcolor = swingBullishColor, xloc = xloc.bar_time, style = label.style_label_up)

    rightTimeBar            = last_bar_time + 20 * (time - time[1])
    string topTag           = swingTrend.bias == BEARISH ? 'Protected High' : 'Target High'
    string bottomTag        = swingTrend.bias == BULLISH ? 'Protected Low' : 'Target Low'

    topLine.set_first_point(    chart.point.new(trailing.lastTopTime, na, trailing.top))
    topLine.set_second_point(   chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_point(         chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_text(          topTag)
    topLabel.set_size(          highLowSwingsSizeInput)
    topLabel.set_tooltip(       getLabelTooltip(topTag) + '\nPrice Level: ' + str.tostring(trailing.top, format.mintick))

    bottomLine.set_first_point( chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    bottomLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_point(      chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_text(       bottomTag)
    bottomLabel.set_size(       highLowSwingsSizeInput)
    bottomLabel.set_tooltip(    getLabelTooltip(bottomTag) + '\nPrice Level: ' + str.tostring(trailing.bottom, format.mintick))

// Classic V1 thin 5% band zones for Premium (top), Equilibrium (50% middle), and Discount (bottom) + hover tooltips
drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style) =>
    var label l_abel    = label.new(na, na, text = tag, color = color.new(zoneColor, 95), textcolor = zoneColor, style = style, size = zoneLabelSizeInput)
    var box b_ox        = box.new(na, na, na, na, bgcolor = color.new(zoneColor, 80), border_color = color(na), xloc = xloc.bar_time)

    b_ox.set_top_left_point(    chart.point.new(trailing.barTime, na, top))
    b_ox.set_bottom_right_point(chart.point.new(last_bar_time, na, bottom))

    l_abel.set_point(           chart.point.new(na, labelIndex, labelLevel))
    l_abel.set_size(            zoneLabelSizeInput)
    l_abel.set_tooltip(         getLabelTooltip(tag) + '\nBand Level: ' + str.tostring(bottom, format.mintick) + ' to ' + str.tostring(top, format.mintick))

drawPremiumDiscountZones() =>
    drawZone(trailing.top, math.round(0.5 * (trailing.barIndex + last_bar_index)), trailing.top, 0.95 * trailing.top + 0.05 * trailing.bottom, 'Premium (Expensive)', premiumZoneColor, label.style_label_down)

    equilibriumLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(equilibriumLevel, last_bar_index, 0.525 * trailing.top + 0.475 * trailing.bottom, 0.525 * trailing.bottom + 0.475 * trailing.top, 'Equilibrium (50%)', equilibriumZoneColorInput, label.style_label_left)

    drawZone(trailing.bottom, math.round(0.5 * (trailing.barIndex + last_bar_index)), 0.95 * trailing.bottom + 0.05 * trailing.top, trailing.bottom, 'Discount (Cheap)', discountZoneColor, label.style_label_up)

//---------------------------------------------------------------------------------------------------------------------}
//MUTABLE VARIABLES & EXECUTION
//---------------------------------------------------------------------------------------------------------------------{
parsedOpen  = showTrendInput ? open : na
candleColor = internalTrend.bias == BULLISH ? swingBullishColor : swingBearishColor
plotcandle(parsedOpen, high, low, close, color = candleColor, wickcolor = candleColor, bordercolor = candleColor)

// Update active Roof / Floor range
updateTrailingExtremes()

if showFVGEff
    deleteFairValueGaps()

getCurrentStructure(swingsLengthEff, false)
getCurrentStructure(internalLengthEff, false, true)

if showEqualEff
    getCurrentStructure(equalHighsLowsLengthInput, true)

detectLiquiditySweeps(false, showSweepsEff)
detectLiquiditySweeps(true, showInternalSweepsEff)

// Delete broken/mitigated Order Blocks FIRST, then count touches & detect In-Band cRSI Turn Dots on surviving bands
if showInternalOBEff
    deleteOrderBlocks(true)
    updateOrderBlockTouches(true)

if showSwingOBEff
    deleteOrderBlocks()
    updateOrderBlockTouches()

// Detect 1-Bar Early cRSI Snap-Back Bands, Ping-Pong Consolidation Bands, and Structure Breakouts
detectCrsiSnapBands()
detectPingPongBands()

displayStructure(true)
displayStructure()

if showFVGEff
    drawFairValueGaps()

// Plot cRSI Turn Dots based on user's selected dropdown mode (🟢 below bar, 🟡 above bar)
bool showBullCrsiDot = confirmed and (crsiDotModeInput == DOTS_ALL ? snapUpFromBot : crsiDotModeInput == DOTS_BAND_AND_EARLY ? (currentAlerts.inBandBullDot or currentAlerts.crsiBuyBand) : crsiDotModeInput == DOTS_IN_BAND_ONLY ? currentAlerts.inBandBullDot : false)
bool showBearCrsiDot = confirmed and (crsiDotModeInput == DOTS_ALL ? snapDownFromTop : crsiDotModeInput == DOTS_BAND_AND_EARLY ? (currentAlerts.inBandBearDot or currentAlerts.crsiSellBand) : crsiDotModeInput == DOTS_IN_BAND_ONLY ? currentAlerts.inBandBearDot : false)
plotshape(showBullCrsiDot, 'cRSI Bullish Turn Dot (🟢)', shape.circle, location.belowbar, color = LIME_DOT, size = size.tiny)
plotshape(showBearCrsiDot, 'cRSI Bearish Turn Dot (🟡)', shape.circle, location.abovebar, color = GOLD_DOT, size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
//DRAW ROOF / FLOOR, BAND ZONES, LAUNCHPAD BANDS & LEVELS (last bar only — fast)
//---------------------------------------------------------------------------------------------------------------------{
if barstate.islast
    if showHighLowSwingsEff
        drawHighLowSwings()

    if showZonesEff
        drawPremiumDiscountZones()

if barstate.islastconfirmedhistory or barstate.islast
    if showInternalOBEff        
        drawOrderBlocks(true)
        
    if showSwingOBEff        
        drawOrderBlocks()

lastBarIndex    := currentBarIndex
currentBarIndex := bar_index
newBar          = currentBarIndex != lastBarIndex

if barstate.islastconfirmedhistory or (barstate.isrealtime and newBar)
    if showDailyLevelsInput and not higherTimeframe('D')
        drawLevels('D', timeframe.isdaily, dailyLevelsStyleInput, dailyLevelsColorInput)

    if showWeeklyLevelsInput and not higherTimeframe('W')
        drawLevels('W', timeframe.isweekly, weeklyLevelsStyleInput, weeklyLevelsColorInput)

    if showMonthlyLevelsInput and not higherTimeframe('M')
        drawLevels('M', timeframe.ismonthly, monthlyLevelsStyleInput, monthlyLevelsColorInput)

//---------------------------------------------------------------------------------------------------------------------}
//ALERTS
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(currentAlerts.internalBullishBOS,        'Minor New High ↑ (BOS)',               'Minor Bullish New High (BOS) formed')
alertcondition(currentAlerts.internalBullishCHoCH,      'Minor U-Turn ↑ (CHoCH)',               'Minor Bullish U-Turn (CHoCH) formed')
alertcondition(currentAlerts.internalBearishBOS,        'Minor New Low ↓ (BOS)',                'Minor Bearish New Low (BOS) formed')
alertcondition(currentAlerts.internalBearishCHoCH,      'Minor U-Turn ↓ (CHoCH)',               'Minor Bearish U-Turn (CHoCH) formed')

alertcondition(currentAlerts.swingBullishBOS,           'Major New High ↑ (Swing BOS)',         'Major Swing Bullish New High (BOS) formed')
alertcondition(currentAlerts.swingBullishCHoCH,         'Major U-Turn ↑ (Swing CHoCH)',         'Major Swing Bullish U-Turn (CHoCH) formed')
alertcondition(currentAlerts.swingBearishBOS,           'Major New Low ↓ (Swing BOS)',          'Major Swing Bearish New Low (BOS) formed')
alertcondition(currentAlerts.swingBearishCHoCH,         'Major U-Turn ↓ (Swing CHoCH)',         'Major Swing Bearish U-Turn (CHoCH) formed')

alertcondition(currentAlerts.bullishSweep,              'Major Bullish Sweep ↑',                'Price swept a Major Low and closed back above (Sweep ↑)')
alertcondition(currentAlerts.bearishSweep,              'Major Bearish Sweep ↓',                'Price swept a Major High and closed back below (Sweep ↓)')
alertcondition(currentAlerts.miniBullishSweep,          'Minor Bullish Sweep ↑',                'Price swept a Minor Low and closed back above (Mini Sweep ↑)')
alertcondition(currentAlerts.miniBearishSweep,          'Minor Bearish Sweep ↓',                'Price swept a Minor High and closed back below (Mini Sweep ↓)')

alertcondition(currentAlerts.crsiBuyBand,               'Early cRSI Buy Band Formed (🎯)',      'New 1-Bar Early cRSI Rubber-Band Floor (🎯 cRSI Buy) formed — Get ready for pullback Long!')
alertcondition(currentAlerts.crsiSellBand,              'Early cRSI Sell Band Formed (🎯)',     'New 1-Bar Early cRSI Rubber-Band Ceiling (🎯 cRSI Sell) formed — Get ready for bounce Short!')
alertcondition(currentAlerts.inBandBullDot,             'In-Band cRSI Bullish Turn Dot (🟢)',   'cRSI Bullish Snap-Back Dot (🟢) fired INSIDE an active Buyer Band!')
alertcondition(currentAlerts.inBandBearDot,             'In-Band cRSI Bearish Turn Dot (🟡)',   'cRSI Bearish Snap-Back Dot (🟡) fired INSIDE an active Seller Band!')

alertcondition(currentAlerts.pingPongBuyBand,           'Ping-Pong Range Buy Band Formed',      'New Ping-Pong Consolidation Floor Buy Band (🏓 Range Buy) formed')
alertcondition(currentAlerts.pingPongSellBand,          'Ping-Pong Range Sell Band Formed',     'New Ping-Pong Consolidation Ceiling Sell Band (🏓 Range Sell) formed')

alertcondition(currentAlerts.internalBullishOrderBlock, 'Minor Buy Band Broken',                'Price broke Minor Buyer Band')
alertcondition(currentAlerts.internalBearishOrderBlock, 'Minor Sell Band Broken',               'Price broke Minor Seller Band')
alertcondition(currentAlerts.swingBullishOrderBlock,    'Major Buy Band Broken',                'Price broke Major Buyer Band')
alertcondition(currentAlerts.swingBearishOrderBlock,    'Major Sell Band Broken',               'Price broke Major Seller Band')

alertcondition(currentAlerts.equalHighs,                'Double Top (Equal Highs)',             'Double Top (Equal Highs) detected')
alertcondition(currentAlerts.equalLows,                 'Double Bottom (Equal Lows)',           'Double Bottom (Equal Lows) detected')

alertcondition(currentAlerts.bullishFairValueGap,       'Bullish FVG',                          'Bullish Fair Value Gap formed')
alertcondition(currentAlerts.bearishFairValueGap,       'Bearish FVG',                          'Bearish Fair Value Gap formed')
//---------------------------------------------------------------------------------------------------------------------}

//---------------------------------------------------------------------------------------------------------------------}
//STRATEGY BACKTEST EXECUTION ENGINE & RISK MANAGEMENT (STRICT cRSI IN-BAND TURN DOT TRIGGER)
//---------------------------------------------------------------------------------------------------------------------{
bool inDateRange      = not useDateFilterInput or (time >= startDateInput and time <= endDateInput)
bool allowLong        = tradeDirectionInput != 'Short Only'
bool allowShort       = tradeDirectionInput != 'Long Only'

// Strict V7 Rule: Entries strictly occur ONLY when inBandBullDot (Long) or inBandBearDot (Short) fire!
bool v7BullEntry      = v7SignalModeInput == 'Strict In-Band Dots Only (inBandBullDot / inBandBearDot)' ? currentAlerts.inBandBullDot : (currentAlerts.inBandBullDot or currentAlerts.crsiBuyBand)
bool v7BearEntry      = v7SignalModeInput == 'Strict In-Band Dots Only (inBandBullDot / inBandBearDot)' ? currentAlerts.inBandBearDot : (currentAlerts.inBandBearDot or currentAlerts.crsiSellBand)

// Helper: Find nearest active Order Block level for structural stops
getNearestBandLevelV7(int bias) =>
    float bandLevel = na
    if internalOrderBlocks.size() > 0
        for i = 0 to internalOrderBlocks.size() - 1
            orderBlock ob = internalOrderBlocks.get(i)
            if ob.bias == bias
                bandLevel := bias == BULLISH ? ob.barLow : ob.barHigh
                break
    bandLevel

// Persistent bracket levels
var float activeLongSL  = na
var float activeLongTP  = na
var float activeShortSL = na
var float activeShortTP = na

// Evaluate Entries on Confirmed Signals within Date Window
bool enterLong  = confirmed and inDateRange and v7BullEntry and allowLong and strategy.position_size <= 0
bool enterShort = confirmed and inDateRange and v7BearEntry and allowShort and strategy.position_size >= 0

if enterLong
    float rawSlDist = slAtrMultInput * atr14
    if slModeInput == 'Structure Band / Swing Low-High'
        float bandFloor = getNearestBandLevelV7(BULLISH)
        float structFloor = not na(bandFloor) ? bandFloor : not na(internalLow.currentLevel) ? internalLow.currentLevel : na
        if not na(structFloor) and close > structFloor
            rawSlDist := (close - structFloor) + (obBufferInput * atr14)
    rawSlDist := math.max(rawSlDist, syminfo.mintick * 10)
    
    float rawTpDist = tpModeInput == 'Risk-to-Reward Ratio (x SL)' ? rawSlDist * rrRatioInput : tpAtrMultInput * atr14
    rawTpDist := math.max(rawTpDist, syminfo.mintick * 10)
    
    activeLongSL := close - rawSlDist
    activeLongTP := close + rawTpDist
    
    strategy.entry('Long', strategy.long)
    strategy.exit('Exit Long', from_entry = 'Long', stop = activeLongSL, limit = activeLongTP)

if enterShort
    float rawSlDist = slAtrMultInput * atr14
    if slModeInput == 'Structure Band / Swing Low-High'
        float bandCeil = getNearestBandLevelV7(BEARISH)
        float structCeil = not na(bandCeil) ? bandCeil : not na(internalHigh.currentLevel) ? internalHigh.currentLevel : na
        if not na(structCeil) and close < structCeil
            rawSlDist := (structCeil - close) + (obBufferInput * atr14)
    rawSlDist := math.max(rawSlDist, syminfo.mintick * 10)
    
    float rawTpDist = tpModeInput == 'Risk-to-Reward Ratio (x SL)' ? rawSlDist * rrRatioInput : tpAtrMultInput * atr14
    rawTpDist := math.max(rawTpDist, syminfo.mintick * 10)
    
    activeShortSL := close + rawSlDist
    activeShortTP := close - rawTpDist
    
    strategy.entry('Short', strategy.short)
    strategy.exit('Exit Short', from_entry = 'Short', stop = activeShortSL, limit = activeShortTP)

// Maintain exit brackets while in position
if strategy.position_size > 0
    strategy.exit('Exit Long', from_entry = 'Long', stop = activeLongSL, limit = activeLongTP)
else if not enterLong
    activeLongSL := na
    activeLongTP := na

if strategy.position_size < 0
    strategy.exit('Exit Short', from_entry = 'Short', stop = activeShortSL, limit = activeShortTP)
else if not enterShort
    activeShortSL := na
    activeShortTP := na

// Window End liquidation
if useDateFilterInput and time > endDateInput and closeAtEndInput
    strategy.close_all(comment = 'Date Window End')

// Visual bracket lines on chart
plot(showBracketPlotsInput and strategy.position_size > 0 ? activeLongSL : showBracketPlotsInput and strategy.position_size < 0 ? activeShortSL : na, 'Active Stop Loss', color = color.red, style = plot.style_linebr, linewidth = 2)
plot(showBracketPlotsInput and strategy.position_size > 0 ? activeLongTP : showBracketPlotsInput and strategy.position_size < 0 ? activeShortTP : na, 'Active Take Profit', color = color.green, style = plot.style_linebr, linewidth = 2)
//---------------------------------------------------------------------------------------------------------------------}
